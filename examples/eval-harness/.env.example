# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
#     cp .env.example .env
#
# Every script loads .env automatically (scripts/_common.py), so you never
# export keys by hand and never paste one into a command that lands in shell
# history.

# ── providers ───────────────────────────────────────────────────────────────
# Only the ones you actually use need values.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── the system under test ───────────────────────────────────────────────────
# What produced the numbers. A version, an image digest, a commit — whatever
# identifies the thing being measured. Runs are refused at promotion time if
# this is unknown, because a baseline that names no system cannot be acted on.
# Leave blank to fall back to this tree's git SHA.
EVAL_BUILD_REF=

# ── spend ceiling ───────────────────────────────────────────────────────────
# A hard mid-run abort, not a pre-flight estimate. Partial results are kept, so
# a sweep that hits the cap still yields a usable report. Applies to
# experiment-run and reference-create. Empty = no cap (not recommended).
EVAL_MAX_COST_USD=5.00

# ── how hard to try ─────────────────────────────────────────────────────────
EVAL_MAX_RETRIES=3
EVAL_CONCURRENCY=1
