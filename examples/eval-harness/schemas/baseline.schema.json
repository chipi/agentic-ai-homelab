{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "baseline",
  "description": "A promoted run. Frozen: a baseline is never edited, only superseded by a new one.",
  "type": "object",
  "required": ["baseline_id", "dataset_id", "promoted_from", "promoted_at", "scores", "build"],
  "properties": {
    "baseline_id": {"type": "string"},
    "dataset_id": {"type": "string"},
    "promoted_from": {"type": "string", "description": "run_id this was promoted from"},
    "promoted_at": {"type": "string"},
    "reason": {"type": "string", "description": "Why this run earned promotion. Required by the runbook, not by the schema."},
    "scores": {"type": "object", "additionalProperties": {"type": "number"}},
    "build": {"type": "object"},
    "supersedes": {"type": ["string", "null"]}
  }
}
