# bugfix-fleet MVP — copy to .env (gitignored). Real values via sops on the mini.

# --- Target repo (the sandbox for the MVP) ---
TARGET_OWNER=chipi
TARGET_REPO=bugfix-fleet-sandbox
REPO_CHECKOUT=/Users/you/.bugfix-fleet/bugfix-fleet-sandbox   # local clone the worktrees branch from

# --- Your GitHub App (create it; download the .pem) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=       # PEM contents; \n-escaped single line is OK
GITHUB_APP_INSTALLATION_ID=   # from installing the App on the target repo
GITHUB_WEBHOOK_SECRET=

# --- Worker harness ---
# Only `direct` is implemented today. The pi/opencode adapters are Phase-0 stubs
# that throw "not implemented" — and the RFC-0002 bake-off concluded the harness
# barely moves fix-rate anyway (ticket quality is the lever). So: direct.
HARNESS=direct

# --- LLM routing (via the homelab LiteLLM gateway, not OpenRouter-direct) ---
# Every call goes through LiteLLM: one budget key, spend metering, gateway-side
# Langfuse. LLM_BASE_URL + LLM_API_KEY (the fleet-bugfix virtual key) override the
# endpoint/key; the models are then litellm aliases (see infra/litellm/config.yaml).
LLM_BASE_URL=http://localhost:4001/v1
LLM_API_KEY=                  # LITELLM_FLEET_BUGFIX_KEY (virtual key, budget-capped)
OPENROUTER_API_KEY=           # legacy fallback if LLM_BASE_URL/LLM_API_KEY are unset
TRIAGE_MODEL=fleet-bugfix-flash
FIX_MODEL=fleet-bugfix-pro
REVIEWER_MODEL=fleet-bugfix-reviewer

# --- Observability (self-hosted Langfuse on the homelab, project "agents") ---
LANGFUSE_HOST=http://homelab:4000
LANGFUSE_PUBLIC_KEY=          # LANGFUSE_INIT_PROJECT_PUBLIC_KEY (infra/langfuse/.env)
LANGFUSE_SECRET_KEY=
