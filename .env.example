# Repo-root master .env template — copy to .env, fill in secrets.
#     cp .env.example .env      # then fill the keys you actually use
#
# This is the operator's "master sheet": the shared HuggingFace/vLLM cache
# config, the homelab box identity, and the cloud LLM provider keys that
# host-side agents/tools read from one place. Per-stack secrets live in each
# stack's own .env.example (infra/vllm/*/, infra/observability/, infra/glitchtip/,
# infra/langfuse/). Nothing here is committed — only this template is.

# ---------- homelab box identity (this host) ----------
HOMELAB_INSTANCE=dgx-llm-1
HOMELAB_CLUSTER=dgx

# ---------- HuggingFace + vLLM (shared caches across every vLLM slot) ----------
# HF token — required for gated model downloads; pin it so the shared cache
# authenticates consistently across coder-next / autoresearch / judges.
HF_TOKEN=
# vLLM API key — clients pass it as `Authorization: Bearer <key>`.
VLLM_API_KEY=buddy-is-the-king
# Model cache paths on the host, mounted 1:1 into the containers.
HF_HOME=/opt/llm-models/huggingface
HF_HUB_CACHE=/opt/llm-models/huggingface
VLLM_CACHE_PATH=/opt/llm-models/vllm-cache

# ---------- cloud LLM provider keys (host-side agents/tools) ----------
# Fill only the providers you use; leave the rest blank. Real keys, never commit.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=

# ---------- local vLLM endpoint (point tools at the DGX-served model) ----------
# The active vLLM slot (see gpu-mode-swap.sh). URL/model track whichever mode is up.
LOCAL_VLLM_URL=http://dgx-llm-1:8003/v1
LOCAL_VLLM_API_KEY=buddy-is-the-king
LOCAL_VLLM_MODEL=autoresearch

# NOTE: the old GRAFANA_CLOUD_PROM_* keys were removed — the homelab moved off
# Grafana Cloud to self-hosted VictoriaMetrics/Grafana on the mini. If you ever
# had a real `glc_...` token here, rotate it (it's dead but was a live secret).
