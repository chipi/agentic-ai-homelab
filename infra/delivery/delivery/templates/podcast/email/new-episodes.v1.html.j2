{% from "email/_macros.html.j2" import episode_head, play_from with context %}
{# new-episodes.v1 — an ALERT that something dropped in a followed show (#2124). Email-client-SAFE,
   the same dark shell and the same item row as your-week-digest.v1 (Gmail strips <body> styles →
   dark theme on a <table bgcolor> with per-cell colors; rows are tables so Outlook keeps them).

   Deliberately SPARSE. This is not a digest: the job is "a show you follow has a new episode,
   here it is" and then get out of the way. Key points, quotes and insights belong in Your Week
   and the daily recap — an alert that takes two minutes to read is a digest wearing a hat.

   Payload — vendored seam schema `newEpisodesPayload`, golden `new-episodes.v1.golden.json`
   (generated by the app's real builder): payload.episodes[] = { episode_slug, episode_title,
   graph_refs[]{id,kind,label}, deep_link, podcast_title? } ; payload.count ; payload.slugs.
   `podcast_title` is OPTIONAL and the app does not send it today — the renderer is
   StrictUndefined, and treating it as present blocked every email for 33 h (2026-10-02/03). #}
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"></head>
<body style="margin:0;padding:0;background-color:#080d1b;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#080d1b" style="background-color:#080d1b;">
  <tr><td align="center" style="padding:32px 16px;">
    <table role="presentation" width="600" cellpadding="0" cellspacing="0" bgcolor="#080d1b" style="width:600px;max-width:600px;background-color:#080d1b;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
      <tr><td style="padding:0 8px;">
        {% set first = payload.episodes[0] %}{% set preheader %}New from {{ first.get('podcast_title') or 'a show you follow' }}{% if payload.count > 1 %} and {{ payload.count - 1 }} more{% endif %}{% endset %}
        {% include "email/_brand.html.j2" %}
        <h1 style="font-size:24px;font-weight:600;margin:8px 0 4px;color:#f0eae0;">
          {% if payload.count == 1 %}A new episode is out{% else %}{{ payload.count }} new episodes are out{% endif %}
        </h1>
        <div style="font-size:14px;color:#acb2c2;margin:0 0 20px;">In shows you follow</div>

        {% for ep in payload.episodes %}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #1e2739;"><tr><td style="padding:18px 0;">
          {{ episode_head(ep.deep_link, ep.episode_title, ep.get('podcast_title'), ep.get('artwork_url'), ep.get('duration_seconds'), ep.get('publish_date')) }}
          {% if ep.graph_refs %}
          <div style="margin-top:10px;">
            {% for ref in ep.graph_refs %}
            <a href="{{ app_origin }}/{{ ref.kind }}/{{ ref.id | urlencode }}" style="display:inline-block;margin:0 6px 6px 0;padding:3px 10px;border:1px solid #1e2739;background-color:#0e1526;border-radius:999px;font-size:12px;color:#f0eae0;text-decoration:none;">{{ ref.label }}</a>
            {% endfor %}
          </div>
          {% endif %}
          <div style="margin-top:8px;"><a href="{{ ep.deep_link | abslink }}" style="color:#efa843;text-decoration:none;font-size:14px;font-weight:600;">Open in Close Listening →</a></div>
        </td></tr></table>
        {% endfor %}

        {% set footer_reason %}You're getting new-episode alerts because you turned them on in Close Listening.{% endset %}
        {% include "email/_footer.html.j2" %}
      </td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>
