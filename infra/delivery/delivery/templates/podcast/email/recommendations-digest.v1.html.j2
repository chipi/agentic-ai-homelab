{% from "email/_macros.html.j2" import episode_head, play_from, open_link, button, notes_link, chips with context %}
{# recommendations-digest.v1 — the monthly "new for you" discovery digest (wave-H). Same
   committed digestPayload shape as your-week-digest.v1 (payload.sections[] of digestItems), same
   email-client-SAFE dark shell; only the framing differs (discovery, not your own captures). #}
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"></head>
<body style="margin:0;padding:0;background-color:#080d1b;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#080d1b" style="background-color:#080d1b;">
  <tr><td align="center" style="padding:32px 16px;">
    <table role="presentation" width="600" cellpadding="0" cellspacing="0" bgcolor="#080d1b" style="width:600px;max-width:600px;background-color:#080d1b;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
      <tr><td style="padding:0 8px;">
        {% set preheader %}Picked for you this month: {% for section in payload['sections'] %}{{ section.kind | section_label }}{% if not loop.last %} · {% endif %}{% endfor %}{% endset %}
        {% include "email/_brand.html.j2" %}
        <h1 style="font-size:24px;font-weight:600;margin:8px 0 4px;color:#f0eae0;">New for you</h1>
        <div style="font-size:14px;color:#acb2c2;margin:0 0 20px;">Fresh episodes across the topics and shows you follow · {{ period_label }}</div>

        {% for section in payload['sections'] %}
        <div style="margin-bottom:8px;color:#acb2c2;font-size:13px;text-transform:uppercase;letter-spacing:.08em;">{{ section.kind | section_label }}</div>
        {% for item in section['items'] %}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #1e2739;"><tr><td style="padding:18px 0;">
          {{ episode_head(item.deep_link, item.get('episode_title') or (item['graph_refs'][0]['label'] if item.get('graph_refs') else 'Open in Close Listening'), item.get('podcast_title'), item.get('artwork_url'), item.get('duration_seconds'), item.get('publish_date'), description=item.get('description'), summary=item.get('summary')) }}
          {% if item.quote is defined %}<p style="color:#f0eae0;margin:10px 0 12px;font-style:italic;">“{{ item.quote }}”</p>{% endif %}
          {{ chips(item.get('graph_refs'), item.get('themes'), item.get('storylines')) }}
          {% if item.deep_link.startswith('/episode/') %}{{ open_link(item.deep_link) }}{% endif %}
        </td></tr></table>
        {% endfor %}
        {% endfor %}

        {% set footer_reason %}You're getting this {{ cadence }} digest because you turned it on in Close Listening.{% endset %}
        {% include "email/_footer.html.j2" %}
      </td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>
