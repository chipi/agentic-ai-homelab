{# Shared pieces of an email's CONTENT (operator 2026-10-05) — the app's episode header and its
   "Play from" control, so every email draws an episode the way the app does. Header and footer are
   _brand / _footer; these are the parts in between that repeat.

   Arguments are explicit (not an item) because the payloads name things differently — the daily
   recap says `title`, the digest `episode_title`. Everything but the link and title is optional,
   and a missing value draws nothing rather than an empty slot. #}

{# The episode header: 64px artwork (or the placeholder tile for an episode that has none), the SHOW in mono small caps above the
   title, then a muted "42 min · Sep 12, 2026" line — the app's EpisodeGroupCard, in a table. #}
{% macro episode_head(link, title, show=None, art=None, duration=None, date=None, title_size=17, description=None, summary=None) -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
  {% if art %}
  <td valign="top" width="64" style="width:64px;padding:2px 14px 0 0;"><a href="{{ link | abslink }}" style="text-decoration:none;"><img src="{{ art | abslink }}" width="64" height="64" alt="" style="display:block;width:64px;height:64px;border:0;border-radius:8px;object-fit:cover;background-color:#0e1526;"></a></td>
  {% elif link.startswith('/episode/') %}
  {# No artwork anywhere (episode or show): the app's placeholder tile, with the brand mark in it,
     so every episode row keeps its artwork column (operator 2026-10-05). Topic links get none. #}
  <td valign="top" width="64" style="width:64px;padding:2px 14px 0 0;"><a href="{{ link | abslink }}" style="text-decoration:none;"><table role="presentation" width="64" height="64" cellpadding="0" cellspacing="0" border="0" style="width:64px;height:64px;border-radius:8px;background-color:#0e1526;"><tr><td align="center" valign="middle"><img src="{{ app_origin }}/brand/email-mark.png" width="23" height="24" alt="" style="display:block;border:0;"></td></tr></table></a></td>
  {% endif %}
  <td valign="top">
    {% if show %}<div style="font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#acb2c2;margin:0 0 3px;">{{ show }}</div>{% endif %}
    <a href="{{ link | abslink }}" style="display:block;color:#f0eae0;text-decoration:none;font-size:{{ title_size }}px;font-weight:600;line-height:1.3;">{{ title }}</a>
    {% set meta = [duration | duration if duration else '', date | pubdate if date else ''] | select | list %}
    {% if meta %}<div style="font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-size:11px;color:#6b7488;margin:4px 0 0;">{{ meta | join(' · ') }}</div>{% endif %}
  </td>
</tr></table>
{# Under the header, full width (operator 2026-10-05): the publisher's own description, muted and
   unlabelled, then OUR summary under a "Summary" label in the app's kicker style — so a reader can
   tell the show's words from ours. Both arrive cut at a word; either may be absent. #}
{% if description %}<p style="margin:12px 0 0;font-size:14px;line-height:1.5;color:#acb2c2;">{{ description }}</p>{% endif %}
{% if summary %}<div style="margin:12px 0 0;"><div style="font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#acb2c2;margin:0 0 3px;">Summary</div><p style="margin:0;font-size:14px;line-height:1.5;color:#f0eae0;">{{ summary }}</p></div>{% endif %}
{%- endmacro %}

{# "▶ Play from 12:03" — the app's one jump-to-a-moment control (PlayFrom.vue), amber because it is
   something you can act on. Only when the item names a moment; the link already carries ?t=. #}
{% macro play_from(link, t_ms) -%}
{% if t_ms is not none %}<div style="margin:10px 0 12px;"><a href="{{ link | abslink }}" style="font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-size:13px;font-weight:700;color:#efa843;text-decoration:none;">▶ Play from {{ (t_ms // 1000) | clock }}</a></div>{% endif %}
{%- endmacro %}

{# The clear call to action under an item (operator 2026-10-05: "New for you" had none, unlike
   "New episodes are out"). A text link in amber — something you can act on. #}
{% macro open_link(link, label='Open in Close Listening →') -%}
<div style="margin:12px 0 0;"><a href="{{ link | abslink }}" style="color:#efa843;text-decoration:none;font-size:14px;font-weight:600;">{{ label }}</a></div>
{%- endmacro %}

{# The primary button — the app's amber button with dark text — for the ONE action an email leads to. #}
{% macro button(link, label) -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 0;"><tr><td bgcolor="#efa843" style="background-color:#efa843;border-radius:6px;"><a href="{{ link | abslink }}" style="display:inline-block;padding:11px 22px;font-size:15px;font-weight:700;color:#080d1b;text-decoration:none;border-radius:6px;">{{ label }}</a></td></tr></table>
{%- endmacro %}

{# The episode's notes panel opened at its top (summary, key points) — the player's ?panel=notes. #}
{% macro notes_link(link) -%}{{ link ~ ('&' if '?' in link else '?') ~ 'panel=notes' }}{%- endmacro %}
