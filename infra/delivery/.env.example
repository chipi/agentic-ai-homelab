# Delivery worker config. Real .env = this + the decrypted secrets (homelab sops-env →
# bootstrap). Commit ONLY this example; .env is gitignored.
#
# The engine is multi-tenant (tenants.yaml). SHARED secrets are global; each tenant has its
# OWN outbox token + VAPID key, named to match its registry entry's *_env keys.

# --- SHARED secrets ---
RESEND_API_KEY=              # one Resend account verifies every tenant's sending domain
DELIVERY_SENTRY_DSN=         # homelab GlitchTip "delivery" project DSN (errors tagged by tenant)

# --- PER-TENANT secrets (one set per tenants.yaml entry) ---
# podcast (player + operator, closelistening)
PODCAST_INTERNAL_OUTBOX_TOKEN=   # must match the podcast app's INTERNAL_OUTBOX_TOKEN
PODCAST_VAPID_PRIVATE_KEY=       # from `delivery-gen-vapid`; back it up
# orrery (enable its registry entry first)
# ORRERY_INTERNAL_OUTBOX_TOKEN=
# ORRERY_VAPID_PRIVATE_KEY=

# --- non-secret global config ---
RESEND_BASE_URL=https://api.resend.com
DELIVERY_POLL_INTERVAL_SEC=30
DELIVERY_BATCH_LIMIT=50
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_HTTP_TIMEOUT_SEC=15
DELIVERY_STATE_DIR=/var/lib/delivery
# OTEL traces (optional): set to the homelab OTLP HTTP endpoint to enable spans.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318

# --- podcast-dev tenant (test twin; only needed when the podcast-dev tenant is
#     uncommented in tenants.yaml). Sandbox only — never point at prod. ---
PODCAST_DEV_INTERNAL_OUTBOX_TOKEN=replace-with-local-dev-player-api-outbox-token
PODCAST_DEV_VAPID_PRIVATE_KEY=replace-with-dev-vapid-private-key
