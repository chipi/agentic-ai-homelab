# GlitchTip — copy to .env (gitignored). Runs on the Mac mini (`homelab`).

# --- Bind ---------------------------------------------------------------
# This host's Tailscale IP (100.x.y.z) so the UI + ingest are on the tailnet,
# never public. 127.0.0.1 for a local smoke test. GLITCHTIP_PORT needs its own
# tailnet ACL grant (the ACL is a per-port allowlist).
GLITCHTIP_LISTEN=127.0.0.1
GLITCHTIP_PORT=8090

# External URL apps + browser use to reach GlitchTip. MUST match how it's
# actually reached (drives DSNs, links, CSRF). On the tailnet, prefer the
# per-service caddy-tailscale node (real cert):
#   https://glitchtip.<tailnet>.ts.net     (or legacy raw: http://100.x.y.z:8090)
GLITCHTIP_DOMAIN=http://127.0.0.1:8090

# Extra Origins trusted for the UI login form-POST (Django CSRF). GLITCHTIP_DOMAIN
# already covers its own host; list any OTHER host the UI is served on here,
# comma-separated, scheme+host[:port]. Needed when migrating the UI to a new node
# while the old address is still in use (accept both). Empty = none extra.
#   CSRF_TRUSTED_ORIGINS=https://glitchtip.<tailnet>.ts.net,https://homelab.<tailnet>.ts.net:8445
CSRF_TRUSTED_ORIGINS=

# --- Secrets (generate strong values) -----------------------------------
POSTGRES_PASSWORD=
SECRET_KEY=

# --- First-run admin (createsuperuser --noinput) ------------------------
DJANGO_SUPERUSER_EMAIL=admin@homelab.local
DJANGO_SUPERUSER_PASSWORD=

# --- Misc ---------------------------------------------------------------
# Registration closed (tailnet-private); the superuser above is the first user.
ENABLE_OPEN_USER_REGISTRATION=false
DEFAULT_FROM_EMAIL=glitchtip@homelab.local
# Outbound mail off by default (console). For real notifications:
# EMAIL_URL=smtp://user:pass@smtp-host:587
