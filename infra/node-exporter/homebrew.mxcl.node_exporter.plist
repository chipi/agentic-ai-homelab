<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>homebrew.mxcl.node_exporter</string>
    <key>UserName</key><string>markodragoljevic</string>
    <key>ProgramArguments</key>
    <array><string>/usr/local/opt/node_exporter/bin/node_exporter</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/usr/local/var/log/node_exporter.log</string>
    <key>StandardErrorPath</key><string>/usr/local/var/log/node_exporter.err.log</string>
</dict>
</plist>
