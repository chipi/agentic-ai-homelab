    ],
    "parameters": {
     "jsCode": "// flotilla's plumbing.call: HMAC-SHA256(secret, timestamp + \".\" + delivery + \".\" + raw body), 5-minute window\nlet raw = '';\ntry { raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8'); } catch (e) { raw = ''; }\nconst h = $input.first().json.headers || {};\nconst ts = String(h['x-flotilla-timestamp'] || ''), delivery = String(h['x-flotilla-delivery'] || ''), sig = String(h['x-flotilla-signature'] || '');\nconst fresh = /^\\d+$/.test(ts) && Math.abs(Math.floor(Date.now() / 1000) - Number(ts)) <= 300;\nreturn [{ json: { ts, delivery, sig, raw, fresh, okDelivery: /^[A-Za-z0-9._:-]{1,128}$/.test(delivery), toSign: ts + '.' + delivery + '.' + raw } }];"
    }
   },
   {
    "id": "case3postdecisio-2",
    "name": "Sign",
    "type": "n8n-nodes-base.crypto",
    "typeVersion": 2,
    "position": [
     660,
     0
    ],
    "credentials": {
     "crypto": {
      "id": "c3postdecision01",
      "name": "flotilla post_decisions callback (HMAC)"
     }
    },
    "parameters": {
     "action": "hmac",
     "type": "SHA256",
     "value": "={{ $json.toSign }}",
     "dataPropertyName": "expected",
     "encoding": "hex"
    }
   },
   {
    "id": "case3postdecisio-3",
    "name": "Check",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     880,
     0
    ],
    "parameters": {
     "jsCode": "const v = $input.first().json;\nconst fail = (code, error) => [{ json: { valid: false, code, response: { error } } }];\nif (!v.raw) return fail(400, 'no body');\nif (!v.okDelivery) return fail(400, 'bad delivery id');\nif (!v.fresh) return fail(401, 'stale or missing timestamp');\nif (v.sig !== 'sha256=' + v.expected) return fail(401, 'bad signature');\nlet b; try { b = JSON.parse(v.raw); } catch (e) { return fail(400, 'body is not JSON'); }\nif (b.action !== 'plumbing.post_decisions') return fail(400, 'this webhook takes plumbing.post_decisions only');\nif (b.mode !== 'send' && b.mode !== 'status') return fail(400, 'mode must be send or status');\nconst p = b.params || {};\nif (p.page !== undefined && p.page !== 'decisions') return fail(400, 'params.page: decisions only');\nif (b.mode === 'send' && (typeof p.text !== 'string' || !p.text.trim() || p.text.length > 8000)) return fail(400, 'params.text: 1 to 8000 characters');\nreturn [{ json: { valid: true, mode: b.mode, delivery: v.delivery, case_id: String(b.case_id || ''), text: String(p.text || '') } }];"
    }
   },
