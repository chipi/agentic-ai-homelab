     0
    ],
    "parameters": {
     "jsCode": "const r = $input.first().json;\nif (r.error || (r.items !== undefined && !Array.isArray(r.items))) throw new Error('tasks.list: Google Tasks did not answer: ' + JSON.stringify(r.error || r).slice(0, 200));\nconst items = r.items || [];\nif (!items.length) return [{ json: { open: 0, note: 'no open tasks' } }];\nreturn items.map(t => ({ json: { title: t.title || '(no title)', due: t.due ? String(t.due).slice(0, 10) : null,\n  notes: t.notes ? (t.notes.length > 300 ? t.notes.slice(0, 300) + '...' : t.notes) : null, ref: t.webViewLink || t.id, id: t.id } }));"
    }
