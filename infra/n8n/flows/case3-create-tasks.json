     "jsCode": "const ids = $input.all().map(i => i.json.id);\nif (!ids.length || ids.some(id => !id)) return [{ json: { code: 502, response: { error: 'Google Tasks did not create every task: ' + JSON.stringify($input.all().map(i => i.json.error || null)).slice(0, 300) } } }];\nreturn [{ json: { code: 200, response: { ref: ('Google Tasks list \"homelab n8n follow-ups\": ' + ids.length + ' task(s), e.g. ' + ids[0]).slice(0, 200) } } }];"
    }
