    ],
    "parameters": {
     "jsCode": "// flotilla's plumbing.call: HMAC-SHA256(secret, timestamp + \".\" + delivery + \".\" + raw body), 5-minute window\nlet raw = '';\ntry { raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8'); } catch (e) { raw = ''; }\nconst h = $input.first().json.headers || {};\nconst ts = String(h['x-flotilla-timestamp'] || ''), delivery = String(h['x-flotilla-delivery'] || ''), sig = String(h['x-flotilla-signature'] || '');\nconst fresh = /^\\d+$/.test(ts) && Math.abs(Math.floor(Date.now() / 1000) - Number(ts)) <= 300;\nreturn [{ json: { ts, delivery, sig, raw, fresh, okDelivery: /^[A-Za-z0-9._:-]{1,128}$/.test(delivery), toSign: ts + '.' + delivery + '.' + raw } }];"
    }
   },
   {
    "id": "case3createtasks-2",
    "name": "Sign",
    "type": "n8n-nodes-base.crypto",
    "typeVersion": 2,
    "position": [
     660,
     0
    ],
    "credentials": {
     "crypto": {
      "id": "c3createtasks001",
      "name": "flotilla create_tasks callback (HMAC)"
     }
    },
    "parameters": {
     "action": "hmac",
     "type": "SHA256",
     "value": "={{ $json.toSign }}",
     "dataPropertyName": "expected",
     "encoding": "hex"
    }
   },
   {
    "id": "case3createtasks-3",
    "name": "Check",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     880,
     0
    ],
    "parameters": {
     "jsCode": "const v = $input.first().json;\nconst fail = (code, error) => [{ json: { valid: false, code, response: { error } } }];\nif (!v.raw) return fail(400, 'no body');\nif (!v.okDelivery) return fail(400, 'bad delivery id');\nif (!v.fresh) return fail(401, 'stale or missing timestamp');\nif (v.sig !== 'sha256=' + v.expected) return fail(401, 'bad signature');\nlet b; try { b = JSON.parse(v.raw); } catch (e) { return fail(400, 'body is not JSON'); }\nif (b.action !== 'plumbing.create_tasks') return fail(400, 'this webhook takes plumbing.create_tasks only');\nif (b.mode !== 'send' && b.mode !== 'status') return fail(400, 'mode must be send or status');\nconst p = b.params || {};\nlet items = [];\nif (b.mode === 'send') {\n  items = Array.isArray(p.items) ? p.items : [];\n  if (items.length < 1 || items.length > 20) return fail(400, 'params.items: 1 to 20 follow-ups');\n  for (const it of items) if (!it || typeof it.what !== 'string' || !it.what.trim() || typeof it.who !== 'string' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(String(it.by)))\n    return fail(400, 'each item needs who, what and by (YYYY-MM-DD)');\n}\nreturn [{ json: { valid: true, mode: b.mode, delivery: v.delivery, case_id: String(b.case_id || ''), items } }];"
    }
   },
