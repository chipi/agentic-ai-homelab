   {
    "id": "case1mcpdsearch01-1",
    "name": "Query",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     440,
     0
    ],
    "parameters": {
     "jsCode": "// the model's words go into a Drive query: cut, control characters out, and \\ and ' escaped, so they stay a string literal\nconst raw = String($input.first().json.query ?? '').replace(/[\\u0000-\\u001f\\u007f]+/g, ' ').trim().slice(0, 200);\nif (!raw) return [{ json: { ok: false, error: 'search needs a non-empty query' } }];\nconst esc = raw.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\");\nreturn [{ json: { ok: true, query: raw, q: \"'19-16sCI6H6egNTbB1G6RJx6cdVdJnq5Q' in parents and fullText contains '\" + esc + \"' and trashed = false\" } }];"
    }
   },
   {
