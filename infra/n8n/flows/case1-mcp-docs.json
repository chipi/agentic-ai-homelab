    ],
    "parameters": {
     "jsCode": "const r = $input.first().json, g = $('Gate').first().json;  // a Drive error here fails the call: the HTTP node throws on non-2xx\nconst full = String(r.data ?? ''), cut = full.length > 60000;\nreturn [{ json: { title: g.title, webViewLink: g.webViewLink, id: g.id, modified: g.modified, truncated: cut,\n  text: cut ? full.slice(0, 60000) + '\\n[cut: the document goes on for ' + (full.length - 60000) + ' more characters]' : full } }];"
    }
