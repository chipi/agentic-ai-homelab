    "name": "Gate",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     1320,
     0
    ],
    "parameters": {
     "jsCode": "// the one rule that matters: a file is read only when it is in the documents folder, or is the decisions doc\nconst m = $input.first().json;\nconst refuse = why => [{ json: { ok: false, error: 'docs.read: ' + why } }];\nif (!m.id) return refuse('no document with that id, or it cannot be read');\nif (!(m.id === '1uzHJ3t00ZdVsUlyLHQdYLo05z-Ugd5FnRLU8V4BW0os' || (Array.isArray(m.parents) && m.parents.includes('19-16sCI6H6egNTbB1G6RJx6cdVdJnq5Q')))) return refuse('refused: that document is not in the documents folder');\nif (m.trashed) return refuse('that document is in the trash');\nconst doc = m.mimeType === 'application/vnd.google-apps.document';\nif (!doc && m.mimeType !== 'text/plain' && m.mimeType !== 'text/markdown') return refuse('only Google Docs, .txt and .md files can be read (this is ' + m.mimeType + ')');\nreturn [{ json: { ok: true, id: m.id, title: m.name, webViewLink: m.webViewLink, modified: m.modifiedTime,\n  url: 'https://www.googleapis.com/drive/v3/files/' + m.id + (doc ? '/export' : ''), qs: doc ? { mimeType: 'text/plain' } : { alt: 'media' } } }];"
    }
   },
