   {
    "id": "case1mcpdsearch01-7",
    "name": "Format",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     1760,
     0
    ],
    "parameters": {
     "jsCode": "// the folder's hits, then the decisions doc when every word of the query is in its name or text (Drive cannot filter by id)\nconst q = $('Query').first().json, folder = $('Folder files').first().json, doc = $('Decisions doc').first().json, text = String($input.first().json.data ?? '');\nif (!Array.isArray(folder.files)) throw new Error('docs.search: Drive did not answer the search: ' + JSON.stringify(folder.error || folder).slice(0, 200));\nconst hits = folder.files.map(f => ({ id: f.id, name: f.name, modified: f.modifiedTime, webViewLink: f.webViewLink }));\nconst terms = q.query.toLowerCase().split(/\\s+/).filter(Boolean), hay = ((doc.name || '') + '\\n' + text).toLowerCase();\nif (doc.id === '1uzHJ3t00ZdVsUlyLHQdYLo05z-Ugd5FnRLU8V4BW0os' && !doc.trashed && terms.every(t => hay.includes(t)) && !hits.some(h => h.id === doc.id))\n  hits.push({ id: doc.id, name: doc.name, modified: doc.modifiedTime, webViewLink: doc.webViewLink });\nif (!hits.length) return [{ json: { matches: 0, query: q.query, note: 'no document in the documents folder or the decisions doc matches' } }];\nreturn hits.slice(0, 10).map(h => ({ json: h }));"
    }
   }
