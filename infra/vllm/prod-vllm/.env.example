# vllm-prod-vllm .env template — copy to .env, fill in, chmod 600.
# NEVER commit .env (repo rule).

# HuggingFace token — required for gated models; pin it so the shared cache
# authenticates consistently with the other vLLM slots.
HF_TOKEN=

# vLLM API key — clients pass this in the Authorization: Bearer header.
# REQUIRED: unlike autoresearch this stack has NO fallback — `docker compose up`
# fails if this is unset/empty (see docker-compose.yml `${VLLM_API_KEY:?…}`).
# Generate a real per-stack secret, do NOT reuse buddy-is-the-king / EMPTY:
#   openssl rand -hex 24
VLLM_API_KEY=

# vLLM's EngineCore ZMQ base port. The API port is HARDCODED to 8003 in
# docker-compose.yml (the only ACL-permitted egress); VLLM_PORT controls ONLY
# the engine, which binds VLLM_PORT+1. Keep AWAY from moss's :8004 — 8090 →
# engine 8091, clear of moss. (Same rationale as autoresearch.)
VLLM_PORT=8090

# GPU memory utilization. prod = concurrent / batched serving profile. Not yet
# measured on this homelab; vLLM upstream default (0.75) is the placeholder
# until a representative concurrent-request soak is sampled. Hard ceiling on
# GB10 unified memory: 0.78 (0.92 OOM-crashes the host — never use it). See
# ../autoresearch/KV_CACHE_SIZING.md for the methodology.
VLLM_GPU_MEM_UTIL=0.75

# Optional: HF and vLLM caches. Defaults align with the other slots so
# downloads are shared.
HF_HOME=/opt/llm-models/huggingface
VLLM_CACHE_PATH=/opt/llm-models/vllm-cache
