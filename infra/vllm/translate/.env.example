# vllm-translate .env template — copy to .env, fill in, chmod 600.
# NEVER commit .env (repo rule).

# HuggingFace token — REQUIRED here, not optional: the Gemma family is GATED, so
# the download 401s without it. Accept the model terms on the HF model page with
# the same account that owns this token, or the pull fails after the container
# starts (which looks like a boot hang, not an auth error).
HF_TOKEN=

# vLLM API key — clients pass this in the Authorization: Bearer header. MIRRORS
# prod-vllm: EMPTY, so the translation client is a drop-in for consumers that
# already send `Bearer EMPTY`. Tailnet-only, so this is defence-in-depth.
# DEFERRED: set a real per-stack secret once consumers can rotate keys.
VLLM_API_KEY=EMPTY

# vLLM's EngineCore ZMQ base port. The API port is HARDCODED to 8005 in
# docker-compose.yml; VLLM_PORT controls ONLY the engine, which binds
# VLLM_PORT+1. 8092 -> engine 8093, clear of prod-vllm's 8091 (VLLM_PORT=8090)
# and of moss:8004. This stack is CO-RESIDENT with prod-vllm, so the engine ports
# must not collide — unlike the :8003 slots, which never run together.
VLLM_PORT=8092

# GPU memory utilization — a fraction of TOTAL unified memory, not of what is
# free. prod-vllm claims 0.75, so this is deliberately LOW: the two run TOGETHER
# and the sum is what matters. The GB10 ceiling for a single stack is 0.78 and
# 0.92 OOM-crashes the host (see ../AGENTS.md).
#
# 0.20 was tried first and vLLM REFUSED to start: that is 24.3 GiB, the weights
# measured 23.31 GiB, and ~1 GiB is not enough for any KV cache. 0.32 gives a
# 38.9 GiB budget -> 15.6 GiB of KV cache, combined ~60% of total with prod-vllm's
# ACTUAL 29 GiB footprint (its 0.75 is a ceiling it may claim, not what it holds).
# Re-measure under real translation load. See ../autoresearch/KV_CACHE_SIZING.md.
VLLM_GPU_MEM_UTIL=0.26

# Optional: HF and vLLM caches. Defaults align with the other slots so downloads
# are shared (the 12B weights are pulled once, not per stack).
HF_HOME=/opt/llm-models/huggingface
VLLM_CACHE_PATH=/opt/llm-models/vllm-cache
