# vllm judge-qwen-next .env template — copy to .env, fill in secrets.
# Judge slot qwen-next of the autoresearch multi-judge sweep (model: Qwen3-Next-80B-A3B-Instruct-NVFP4).
# Only one judge runs at a time on the single GPU — see gpu-mode-swap.sh `judging n`.

# HuggingFace token — required for gated models; pin it so the shared cache
# authenticates consistently across every vLLM slot.
HF_TOKEN=

# vLLM API key — clients pass this in the Authorization: Bearer header.
VLLM_API_KEY=buddy-is-the-king

# Port this judge vLLM listens on (all judges share :8003 — one at a time).
VLLM_PORT=8003

# GPU memory utilization. Methodology + per-model values: ../autoresearch/KV_CACHE_SIZING.md.
# Hard ceiling on GB10 unified memory is 0.78 (0.92 OOM-crashes — never use it).
VLLM_GPU_MEM_UTIL=0.60

# Shared HF + vLLM caches (aligned with the other slots so downloads are shared).
HF_HOME=/opt/llm-models/huggingface
VLLM_CACHE_PATH=/opt/llm-models/vllm-cache
