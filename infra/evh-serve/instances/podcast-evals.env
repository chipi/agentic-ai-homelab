# The podcast pipeline's evals: chipi/podcast-scraper-eval-data (private). The licensed text under
# records/materialized/ is gitignored, so a clone never has it and it never reaches this host.
NAME=podcast-evals
HOST=podcast-evals.tail6d0ed4.ts.net
REPO_URL=git@github.com:chipi/podcast-scraper-eval-data.git
BRANCH=main
# evaluation-harness 0.8.2+ (pinned by eval-data 0da4c730): serve no write tools (study-ask, study-tell)
MCP_FLAGS=--no-agent-tools
