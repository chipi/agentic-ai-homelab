# Reverse-proxy (caddy-tailscale) — copy to .env and fill in.
# TS_AUTHKEY: a Tailscale auth key that registers the per-service nodes.
#   Mint at login.tailscale.com -> Settings -> Keys -> Generate auth key:
#   Reusable, Ephemeral off, Tags: tag:homelab-svc. (tag must exist in the
#   tailnet ACL: podcast_scraper-infra tailscale/policy.hujson.)
# The .env itself is gitignored and never committed.
TS_AUTHKEY=tskey-auth-REPLACE_ME
