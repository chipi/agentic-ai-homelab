# The X3 staging engine's dockerd (ADR-0013): everything it differs in is /etc/docker-staging/daemon.json.
# No socket unit: the daemon makes /run/docker-staging.sock itself, root:robotics 0660.
[Unit]
Description=Docker engine for robotics-lab staging on the X3 (ADR-0013)
Documentation=https://github.com/chipi/agentic-ai-homelab/blob/main/docs/adr/ADR-0013-x3-staging-docker-engine.md
After=network-online.target nss-lookup.target containerd-staging.service time-set.target
Wants=network-online.target
Requires=containerd-staging.service
RequiresMountsFor=/var/lib/docker-staging /srv/robotics-lab
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=notify
ExecStart=/usr/bin/dockerd --config-file /etc/docker-staging/daemon.json
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutStartSec=0
RestartSec=2
Restart=always
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=process
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
