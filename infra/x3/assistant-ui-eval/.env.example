# Secrets for the UI evaluation; copy to .env (gitignored). Generated values: `openssl rand -hex N`.
LITELLM_API_KEY=<virtual key assistant-ui-eval, from the mini's ~/assistant-ui-eval-litellm.env>
GRAFANA_SERVICE_ACCOUNT_TOKEN=<Grafana service account assistant-mcp (Viewer), from the mini's ~/assistant-grafana-mcp.env>
CREDS_KEY=<openssl rand -hex 32>
CREDS_IV=<openssl rand -hex 16>
JWT_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>
MEILI_MASTER_KEY=<openssl rand -hex 16>
WEBUI_SECRET_KEY=<openssl rand -hex 32>
# after creating your account in each UI, set these to false and `docker compose up -d`
LIBRECHAT_ALLOW_REGISTRATION=true
OPENWEBUI_ENABLE_SIGNUP=true
# Bearer secret for LibreChat's /metrics; the X3 collector reads the same value from
# ~/.config/assistant-ui-eval/metrics-secret (mode 600).
LIBRECHAT_METRICS_SECRET=
