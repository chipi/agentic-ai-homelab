# One GitHub Actions runner, as a container on gh-runner's rootless engine (a user unit; ADR-0015).
# %i is the instance, e.g. closelistening-studio-1; its settings are in ~/ci-runner/%i.env and its
# registration in the volume ci-runner-%i (register.sh writes both). One runner takes one job at a time.
[Unit]
Description=GitHub Actions runner %i
After=docker@%i.service
Requires=docker@%i.service

[Service]
Environment=DOCKER_HOST=unix://%t/e-%i/docker.sock
Environment=IMAGE=ci-runner:2.338.2-4
# The image is built from ~/ci-runner/image/Dockerfile, once per engine; later starts find it.
ExecStartPre=/bin/sh -c 'docker image inspect "$IMAGE" >/dev/null 2>&1 || docker build -q -t "$IMAGE" %h/ci-runner/image'
ExecStartPre=-/usr/bin/docker rm -f ci-runner-%i
ExecStartPre=/bin/mkdir -p %h/ci-runner/work/%i
# This runner's own downloads, kept across its jobs (the container is fresh per job): the tool cache of
# setup-node/setup-python (RUNNER_TOOL_CACHE), Playwright's browsers, apt's packages. On the X3 each job
# fetched them again over the home line: setup-node 58 s against 3 s on GitHub's VMs, Playwright's chromium
# 126 s against 10 s (player, medians, 2026-11). One folder per runner, so two jobs never write one at once;
# entrypoint.sh prunes it at every start (5 GB, 14 days unused). Mounted at its host path, as the work
# folder, because the runner hands the tool cache to job containers by path.
ExecStartPre=/bin/mkdir -p %h/ci-runner/cache/%i/toolcache %h/ci-runner/cache/%i/ms-playwright %h/ci-runner/cache/%i/apt
# A job's `-v /var/run/docker.sock:...` (integration's stack test mounts it into its API container) is
# resolved by the engine, inside rootlesskit's mount namespace, where /run/docker.sock was the X3's own
# system socket: "permission denied while trying to connect to the docker API" (2026-11-26). Point it at
# this runner's engine, in that namespace, at every start; the engine keeps running.
ExecStartPre=/bin/sh -c 'nsenter -U --preserve-credentials -m -t "$$(cat %t/e-%i/dockerd-rootless/child_pid)" ln -sfn %t/e-%i/docker.sock /run/docker.sock'
# Root in the container is gh-runner on the X3 (rootless); entrypoint.sh does its set-up as root and
# runs the runner and its jobs as the image's user runner, as on GitHub's VMs. --network host is the
# engine's own network, where a
# job's service containers publish their ports. Jobs written for GitHub's runners call sudo; this
# image's /etc/sudoers allows only the sudo group (no sudoers.d), and a group added after start does
# not reach the running process, so root joins it here (--group-add sudo).
ExecStart=/usr/bin/docker run --rm --name ci-runner-%i --user 0 --group-add sudo --network host \
  --env-file %h/ci-runner/%i.env -e RUNNER_ALLOW_RUNASROOT=1 \
  -v ci-runner-%i:/home/runner/state \
  -v %h/ci-runner/work/%i:%h/ci-runner/work/%i -e RUNNER_WORK=%h/ci-runner/work/%i \
  -e TMPDIR=%h/ci-runner/work/%i/_tmp \
  -v %h/ci-runner/cache/%i:%h/ci-runner/cache/%i -e CI_CACHE=%h/ci-runner/cache/%i \
  -e RUNNER_TOOL_CACHE=%h/ci-runner/cache/%i/toolcache -e PLAYWRIGHT_BROWSERS_PATH=%h/ci-runner/cache/%i/ms-playwright \
  -v %h/ci-runner/entrypoint.sh:/entrypoint.sh:ro \
  -v %t/e-%i/docker.sock:/var/run/docker.sock \
  ${IMAGE} bash /entrypoint.sh
ExecStop=-/usr/bin/docker stop -t 60 ci-runner-%i
Restart=always
RestartSec=10
# The first start of an engine pulls the base image and builds (a few minutes).
TimeoutStartSec=15min
# 3: not registered yet (entrypoint.sh); restarting would not help.
RestartPreventExitStatus=3

[Install]
WantedBy=default.target
