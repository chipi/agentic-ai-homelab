# /etc/sudoers.d/robotics-prod (ADR-0013): the only way to the X3 prod engine. The script checks its
# arguments itself (a 40-hex commit on GitHub's main for `up`); sudo's env_reset keeps the caller's
# environment out.
marko ALL=(root) NOPASSWD: /usr/local/libexec/robotics-prod-deploy up, /usr/local/libexec/robotics-prod-deploy up *, /usr/local/libexec/robotics-prod-deploy rollback, /usr/local/libexec/robotics-prod-deploy smoke, /usr/local/libexec/robotics-prod-deploy status
