# The X3 prod engine's own containerd (ADR-0013). The distro's containerd.service, with its own
# config: root on @docker-prod, its own state and sockets under /run/containerd-prod.
[Unit]
Description=containerd for the X3 prod engine (ADR-0013)
Documentation=https://github.com/chipi/agentic-ai-homelab/blob/main/docs/adr/ADR-0013-x3-prod-docker-engine.md
After=network.target dbus.service
RequiresMountsFor=/var/lib/docker-prod

[Service]
ExecStartPre=-/usr/bin/modprobe overlay
ExecStart=/usr/bin/containerd --config /etc/containerd-prod/config.toml
Type=notify
Delegate=yes
KillMode=process
Restart=always
RestartSec=5
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
OOMScoreAdjust=-999

[Install]
WantedBy=multi-user.target
