# ci-ops-poller — copy to .env (gitignored). Runs on the Mac mini (`homelab`).
#
# GitHub token: a FINE-GRAINED PAT, read-only, scoped to chipi/podcast_scraper:
#   Repository access → Only select repositories → podcast_scraper
#   Permissions → Repository → Actions: Read-only  (that's the only scope needed)
# Without it the API is 60 req/h and private repos are invisible. Never commit it.
GITHUB_TOKEN=

# What to poll and where to ship (defaults are correct for the mini).
GITHUB_REPO=chipi/podcast_scraper
VLOGS_URL=http://localhost:9428

# Cadence + windows (seconds / hours / minutes / days).
POLL_INTERVAL=900          # every 15 min
LOOKBACK_HOURS=24          # first-run backfill window
OVERLAP_MINUTES=120        # re-scan window each poll (catch late-completing runs; dedup handles repeats)
SEEN_TTL_DAYS=7            # how long the dedup set remembers run_id:attempt

# ops_event/v1 stream fields. Tier-1 deploys use env=prod; Tier-2 CI defaults to "ci".
OPS_APP=podcast_scraper
OPS_ENV=ci

# Tier-1 workflows are emitted from inside the runner (push path) — skip here so
# we don't double-count. Comma-separated workflow file names.
SKIP_WORKFLOWS=deploy-prod.yml,deploy-player.yml,backup-corpus-prod.yml,backup-player-appdata-prod.yml
