# LiteLLM gateway secrets — copy to .env on the mini, fill, chmod 600.
# NEVER commit .env (repo rule).

# postgres (compose-internal)
LITELLM_PG_PASSWORD=<generate: openssl rand -hex 24>

# admin master key for the proxy (mint virtual keys with it; never give to consumers)
LITELLM_MASTER_KEY=sk-<generate: openssl rand -hex 24>

# provider routes
OPENROUTER_API_KEY=<the openrouter key>
# future direct providers (uncomment + add routes in config.yaml):
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=

# Langfuse callback (self-hosted). These MUST equal Langfuse's seeded key pair —
# infra/langfuse/.env LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY (project
# `agents`). They are the single source of truth; keep these two in sync with it.
# If they drift, LiteLLM 401s on every trace export and logs NOTHING (silent data
# loss) — that happened when the OrbStack→colima migration reprovisioned Langfuse
# with fresh volumes + a new seeded pair. Verify: `curl -u $PK:$SK
# http://127.0.0.1:4000/api/public/traces?limit=1` → 200, not 401.
LANGFUSE_HOST=http://host.docker.internal:4000
LANGFUSE_PUBLIC_KEY=<= infra/langfuse/.env LANGFUSE_INIT_PROJECT_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<= infra/langfuse/.env LANGFUSE_INIT_PROJECT_SECRET_KEY>

# GlitchTip (sentry-compatible) error reporting for the gateway itself.
# NOTE: use host.docker.internal, not homelab — tailnet names do not resolve
# inside the container bridge (same for LANGFUSE_HOST above).
SENTRY_DSN=<from the litellm GlitchTip project — see README, host.docker.internal:8090>
