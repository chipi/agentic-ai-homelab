// Research collector for the X3 workstation (Linux, AMD Strix Halo): what a local model run
// needs next to its results — host CPU/memory/pressure, the AMD GPU's busy % and memory (drm
// collector), and the Ollama log — pushed to the mini over the tailnet. Same series names as the
// DGX's collector, so one board can put the three research hosts side by side (instance label).
//
// Runs as a systemd USER service (no root): see alloy-research.service and README.md. Ollama on
// this box is started by eval-harness through the long-job skill, so its log is that job's file,
// not a journal.

prometheus.exporter.unix "host" {
  enable_collectors  = ["drm", "pressure"]
  disable_collectors = ["mountstats", "infiniband", "nfs", "nfsd", "tapestats", "ipvs", "bonding", "btrfs"]
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  job_name        = "integrations/unix"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.instance.receiver]
}

prometheus.relabel "instance" {
  rule {
    target_label = "instance"
    replacement  = "x3"
  }
  forward_to = [prometheus.remote_write.sink.receiver]
}

prometheus.remote_write "sink" {
  endpoint {
    url = "https://vm.tail6d0ed4.ts.net/api/v1/write"
  }
  external_labels = { cluster = "workstation" }
}

local.file_match "ollama" {
  path_targets = [{
    "__path__" = "/home/marko/.local/state/long-job/*ollama*.log",
    "job"      = "ollama",
    "service"  = "ollama",
  }]
}

// The assistant (infra/x3/ollama-assistant.service, port 11435): the same Ollama log shape.
local.file_match "assistant" {
  path_targets = [{
    "__path__" = "/home/marko/.local/state/log/ollama-assistant/ollama.log",
    "job"      = "ollama",
    "service"  = "assistant",
  }]
}

loki.source.file "assistant" {
  targets       = local.file_match.assistant.targets
  tail_from_end = true
  forward_to    = [loki.write.sink.receiver]
}

loki.source.file "ollama" {
  targets       = local.file_match.ollama.targets
  // Start at the end: the file predates the collector, and a backfill would arrive stamped "now".
  tail_from_end = true
  forward_to    = [loki.write.sink.receiver]
}

// The assistant UI evaluation stack (infra/x3/assistant-ui-eval, RFC-0008 phase 3): its containers'
// logs, LibreChat's /metrics (bearer secret) and mcp-grafana's. Only assistant-* containers: the
// rest of this box's Docker is the operator's dev work.
discovery.docker "assistant" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "name"
    values = ["assistant-"]
  }
}

discovery.relabel "assistant" {
  targets = discovery.docker.assistant.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "assistant" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.assistant.output
  forward_to = [loki.relabel.assistant.receiver]
}

// service set after the source (target labels key read positions; see the mini's config).
loki.relabel "assistant" {
  rule {
    source_labels = ["container"]
    target_label  = "service"
  }
  forward_to = [loki.write.sink.receiver]
}

prometheus.scrape "librechat" {
  targets         = [{ __address__ = "127.0.0.1:3080" }]
  job_name        = "librechat"
  scrape_interval = "30s"
  authorization {
    type             = "Bearer"
    credentials_file = "/home/marko/.config/assistant-ui-eval/metrics-secret"
  }
  forward_to = [prometheus.relabel.instance.receiver]
}

prometheus.scrape "mcp_grafana" {
  targets         = [{ __address__ = "127.0.0.1:3082" }]
  job_name        = "mcp-grafana"
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.instance.receiver]
}

loki.write "sink" {
  endpoint {
    url = "https://vlogs.tail6d0ed4.ts.net/insert/loki/api/v1/push"
  }
  external_labels = { instance = "x3", cluster = "workstation", env = "research" }
}
