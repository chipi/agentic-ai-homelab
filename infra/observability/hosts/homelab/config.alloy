// =============================================================================
// homelab (Mac mini) SELF-monitoring collector — runs as a CONTAINER on colima.
//
// The DGX collector can't run here (it's Linux: network_mode host, /rootfs, DCGM).
// On macOS the split is:
//   • macOS HOST metrics (cpu/mem/DISK/load) → a NATIVE node_exporter (brew) on
//     :9100, reached from this container via host.docker.internal. A container
//     CANNOT see real macOS host stats (it sees the colima Linux VM), so the
//     host exporter MUST run natively — see README.
//   • CONTAINER logs (the whole observability stack) → Docker socket.
// Writes to the LOCAL backend on the same box (host.docker.internal published
// ports). No tailnet / no ACL — everything is loopback-local.
//
// ⚠ EDITING CAVEAT — this file is a SINGLE-FILE bind mount
// (docker-compose.yml: ./config.alloy:/etc/alloy/config.alloy:ro). Editing it
// IN PLACE is fine (Alloy hot-reloads). But REPLACING the file (scp/mv/rsync →
// new inode) breaks the bind mount — the container keeps the old inode and the
// new content is never seen. After any scp/mv of this file you MUST
// `docker restart alloy-homelab` to re-bind. (Edit-in-place with sed/an editor
// avoids this; a whole-file copy does not.)
// =============================================================================

// ---------- HOST: macOS via native node_exporter ----------
prometheus.scrape "node" {
  targets         = [{ __address__ = "host.docker.internal:9100", instance = "homelab" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "node"
  scrape_interval = "30s"
}

// ---------- LiteLLM stack health: postgres-exporter ----------
// LiteLLM's own /metrics is enterprise-gated (401), so the stack's postgres-
// exporter sidecar is the health probe. Published on the host at :9189 (reached
// like node, via host.docker.internal). Feeds up{job="litellm-postgres"}, which
// the "LiteLLM gateway down" alert (rules.yaml) watches as a dead-man's switch —
// without this scrape the metric is absent and the alert fires false NoData.
prometheus.scrape "litellm_postgres" {
  targets         = [{ __address__ = "host.docker.internal:9189", instance = "homelab" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "litellm-postgres"
  scrape_interval = "30s"
}

// ---------- Delivery workers (podcast_scraper #1412 / ADR-144) ----------
// Each delivery loop exposes Prometheus /metrics on loopback (compose publishes
// 127.0.0.1:9110 email / 9111 push / 9112 events); reach them via host.docker.internal.
// Feeds the delivery_* series the "Delivery worker" Grafana board reads (bounce-rate =
// the deliverability canary). Logs are already captured by the generic container source
// below. Source of truth: podcast_scraper-infra/infra/observability/delivery.alloy.
prometheus.scrape "delivery" {
  targets = [
    { __address__ = "host.docker.internal:9110", instance = "homelab", channel = "email" },
    { __address__ = "host.docker.internal:9111", instance = "homelab", channel = "push" },
    { __address__ = "host.docker.internal:9112", instance = "homelab", channel = "events" },
  ]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "delivery"
  scrape_interval = "30s"
}

// ---------- CONTAINERS: cAdvisor (per-container cpu/mem/io) ----------
// cadvisor is a bridge container on THIS compose's network (see docker-compose.yml),
// reached by docker DNS at cadvisor:8080 — NOT host.docker.internal (which points at
// the Mac, not the colima VM). Was excluded under OrbStack (unreliable); viable on
// colima. The keep-list curates cAdvisor's firehose to the series the container
// dashboards use (matches the prod-podcast collector's cadvisor_keep).
prometheus.scrape "cadvisor" {
  targets         = [{ __address__ = "cadvisor:8080", instance = "homelab" }]
  forward_to      = [prometheus.relabel.cadvisor_keep.receiver]
  job_name        = "cadvisor"
  scrape_interval = "60s"
}

prometheus.relabel "cadvisor_keep" {
  forward_to = [prometheus.remote_write.local.receiver]
  rule {
    source_labels = ["__name__"]
    regex         = "container_cpu_usage_seconds_total|container_memory_(usage|working_set|max_usage|rss)_bytes|container_fs_(reads|writes)_bytes_total|container_network_(receive|transmit)_bytes_total|container_oom_events_total|container_start_time_seconds|container_last_seen|container_spec_memory_limit_bytes|container_spec_cpu_(quota|period)|container_tasks_state|machine_cpu_cores|machine_memory_bytes"
    action        = "keep"
  }
}

// ---------- LOGS: all docker container stdout/stderr ----------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.homelab_std.receiver]
}

// ---------- homelab log standard: trace_id -> structured_metadata ----------
// See infra/observability/LOG-STANDARD.md. Extracts the 32-hex trace id from a
// traceparent / sentry-trace pattern into structured_metadata (a queryable
// field, not a high-cardinality stream label). Infra logs here rarely carry
// trace context, but the standard is applied uniformly on every Alloy.
loki.process "homelab_std" {
  stage.regex {
    expression = "(?:00-)?(?P<trace_id>[a-f0-9]{32})-[a-f0-9]{16}"
  }
  stage.structured_metadata {
    values = { trace_id = "" }
  }
  forward_to = [loki.write.local.receiver]
}

// ---------- PUSH: metrics → local VictoriaMetrics ----------
prometheus.remote_write "local" {
  endpoint {
    url = coalesce(sys.env("REMOTE_WRITE_URL"), "http://host.docker.internal:8428/api/v1/write")
  }
  external_labels = {
    instance = "homelab",
    cluster  = "homelab",
  }
}

// ---------- PUSH: logs → local VictoriaLogs ----------
loki.write "local" {
  endpoint {
    url = coalesce(sys.env("LOGS_WRITE_URL"), "http://host.docker.internal:9428/insert/loki/api/v1/push")
  }
  external_labels = {
    instance = "homelab",
    cluster  = "homelab",
    env      = "prod",
  }
}
