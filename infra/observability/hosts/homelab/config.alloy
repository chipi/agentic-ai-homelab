// =============================================================================
// homelab (Mac mini) SELF-monitoring collector — runs as a CONTAINER on colima.
//
// The DGX collector can't run here (it's Linux: network_mode host, /rootfs, DCGM).
// On macOS the split is:
//   • macOS HOST metrics (cpu/mem/DISK/load) → a NATIVE node_exporter (brew) on
//     :9100, reached from this container via host.docker.internal. A container
//     CANNOT see real macOS host stats (it sees the colima Linux VM), so the
//     host exporter MUST run natively — see README.
//   • CONTAINER logs (the whole observability stack) → Docker socket.
// Writes to the LOCAL backend on the same box (host.docker.internal published
// ports). No tailnet / no ACL — everything is loopback-local.
//
// ⚠ EDITING CAVEAT — this file is a SINGLE-FILE bind mount
// (docker-compose.yml: ./config.alloy:/etc/alloy/config.alloy:ro). Editing it
// IN PLACE is fine (Alloy hot-reloads). But REPLACING the file (scp/mv/rsync →
// new inode) breaks the bind mount — the container keeps the old inode and the
// new content is never seen. After any scp/mv of this file you MUST
// `docker restart alloy-homelab` to re-bind. (Edit-in-place with sed/an editor
// avoids this; a whole-file copy does not.)
// =============================================================================

// ---------- HOST: macOS via native node_exporter ----------
prometheus.scrape "node" {
  targets         = [{ __address__ = "host.docker.internal:9100", instance = "homelab" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "node"
  scrape_interval = "30s"
}

// ---------- LiteLLM stack health: postgres-exporter ----------
// LiteLLM's own /metrics is enterprise-gated (401), so the stack's postgres-
// exporter sidecar is the health probe. Feeds up{job="litellm-postgres"}, which
// the "LiteLLM gateway down" alert (rules.yaml) watches as a dead-man's switch —
// without this scrape the metric is absent and the alert fires false NoData.
// Scraped VM-INTERNALLY by container name over the litellm docker network (alloy
// joins litellm_default — see docker-compose.yml), NOT via the host's forwarded
// :9189. host.docker.internal round-trips through lima's SSH forward, which dies
// on any network transition (see recipes/colima-lima-forwarding-recovery.md) —
// that break once vanished this metric and false-fired the gateway-down alert.
prometheus.scrape "litellm_postgres" {
  targets         = [{ __address__ = "litellm-postgres-exporter:9187", instance = "homelab" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "litellm-postgres"
  scrape_interval = "30s"
}

// ---------- Langfuse datastores (redis + postgres) ----------
// Both exporters had been up 8 days serving /metrics that NOTHING scraped: a check for
// `redis_*` in VictoriaMetrics returned ZERO series, so the LLM-observability stack's own
// datastores were the one unmonitored corner of the estate. Found 2026-09-18 while chasing
// the langfuse-worker socket-timeout noise — the tell was having to curl the exporter by
// hand because there was no series to query.
//
// Container names over langfuse_default, NOT the host's :9122/:9188 forwards, for the same
// lima-fragility reason as litellm_postgres above.
//
// `redis_connected_clients` is the one worth watching: langfuse#13601 reports the
// socket-timeout watchdog leaking connections to 87+. Ours reads 96 — in that range, but
// FLAT over the minutes observed, and a leak only shows as monotonic growth over hours.
// UNRESOLVED on purpose: langfuse opens a blocking connection per BullMQ queue and there
// are 15+, so 96 may simply be its pool. This scrape is what makes the question answerable
// at all; before it, no `redis_*` series existed anywhere.
//
// ⚠ Check it via the SERIES, not by hand. Host :9121 is GLITCHTIP's exporter (5 clients);
// langfuse's is remapped to :9122, and both report `9121/tcp` container-side. That trap
// produced a confidently wrong "we are not leaking" reading on 2026-09-18.
//
// Note redis_connections_received_total is NOT a leak signal here: ~21.8/min is this
// stack's own 3s `redis-cli ping` healthcheck, unchanged before and after the watchdog fix.
prometheus.scrape "langfuse_redis" {
  targets         = [{ __address__ = "langfuse-redis-exporter-1:9121", instance = "homelab" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "langfuse-redis"
  scrape_interval = "30s"
}

prometheus.scrape "langfuse_postgres" {
  targets         = [{ __address__ = "langfuse-postgres-exporter-1:9187", instance = "homelab" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "langfuse-postgres"
  scrape_interval = "30s"
}

// ---------- Delivery workers (podcast_scraper #1412 / ADR-144) ----------
// Each delivery loop exposes Prometheus /metrics (email 9110 / push 9111 / events 9112).
// Feeds the delivery_* series the "Delivery worker" Grafana board reads (bounce-rate =
// the deliverability canary). Logs are already captured by the generic container source
// below. Source of truth: chipi/infra/infra/observability/delivery.alloy.
// Scraped VM-INTERNALLY by container name over the delivery docker network (alloy joins
// delivery_default — see docker-compose.yml), NOT via the host's forwarded :9110-9112,
// so the board survives a lima forward break (see the litellm_postgres note above).
prometheus.scrape "delivery" {
  targets = [
    { __address__ = "delivery-email:9110", instance = "homelab", channel = "email" },
    { __address__ = "delivery-push:9111", instance = "homelab", channel = "push" },
    { __address__ = "delivery-events:9112", instance = "homelab", channel = "events" },
  ]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "delivery"
  scrape_interval = "30s"
}

// NOTE: cAdvisor was tried here for per-container cpu/mem/io but doesn't work on
// colima (cgroup v2 + cgroupfs + cgroupns — it only sees system/systemd cgroups, not
// the docker container scopes). Covered instead by an inline `docker stats` block in
// mini-metrics/push.sh → mini_container_cpu_percent / mini_container_mem_bytes, keyed
// by container NAME.

// ---------- LOGS: all docker container stdout/stderr ----------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.relabel.service.receiver]
}

// service = the container name without compose's replica suffix (glitchtip-worker-1 ->
// glitchtip-worker); for the delivery workers it equals their OTel service.name.
// Set HERE, after the source, never in discovery.relabel: loki.source.docker keys its
// read positions by the target's labels, so a new target label makes every container
// a new target and re-reads its whole docker log (2026-10-14: ~30 days replayed as
// duplicates before this was moved).
loki.relabel "service" {
  rule {
    source_labels = ["container"]
    regex         = "(.+?)(-[0-9]+)?"
    target_label  = "service"
  }
  // Home Assistant is a home system, not the stack's own operations: its compose labels
  // say telemetry.namespace=home-automation, telemetry.environment=prod. The generic
  // telemetry.* rule (ADR-0010 phase B) isn't on the mini: container labels exist only as
  // target labels, and a new target label replays every container's log. A per-line
  // label wins over loki.write's external_labels (tested 2026-10-27, alloy v1.17.0).
  rule {
    source_labels = ["container"]
    regex         = "home-assistant"
    target_label  = "namespace"
    replacement   = "home-automation"
  }
  rule {
    source_labels = ["container"]
    regex         = "home-assistant"
    target_label  = "environment"
    replacement   = "prod"
  }
  forward_to = [loki.process.homelab_std.receiver]
}

// ---------- homelab log standard: trace_id -> structured_metadata ----------
// See infra/observability/LOG-STANDARD.md. Extracts the 32-hex trace id into
// structured_metadata (a queryable field, not a high-cardinality stream label)
// from every shape the apps write: `trace_id=<id>` (OTel log correlation),
// `"trace_id":"<id>"` (JSON events, e.g. delivery), `trace=<id>` (access log,
// pipeline), and traceparent / sentry-trace headers. Same pattern as the Grafana
// VictoriaLogs derived field — keep the two identical.
loki.process "homelab_std" {
  // Alloy's own graph-evaluation logs carry a `trace_id=` for traces it never
  // exports; skip its container so they don't get a dead trace_id field.
  stage.match {
    selector = "{container!~\"alloy.*\"}"

    stage.regex {
      expression = "(?:trace_id[=\":\\s]+|trace=|00-|sentry-trace[=\":\\s]+)(?P<trace_id>[a-f0-9]{32})"
    }
    stage.structured_metadata {
      values = { trace_id = "" }
    }
  }
  forward_to = [loki.write.local.receiver]
}

// ---------- PUSH: metrics → local VictoriaMetrics ----------
prometheus.remote_write "local" {
  endpoint {
    url = coalesce(sys.env("REMOTE_WRITE_URL"), "http://victoriametrics:8428/api/v1/write")
  }
  external_labels = {
    instance = "homelab",
    cluster  = "homelab",
  }
}

// ---------- PUSH: logs → local VictoriaLogs ----------
loki.write "local" {
  endpoint {
    url = coalesce(sys.env("LOGS_WRITE_URL"), "http://victorialogs:9428/insert/loki/api/v1/push")
  }
  external_labels = {
    instance = "homelab",
    cluster  = "homelab",
    // Everything on the mini is the stack's own self-monitoring, the fleets and the shared
    // gateway: `operations` (ADR-0010, LOG-STANDARD), not the apps' `prod`. Until 2026-10-15
    // this said prod, so ~100k mini lines per 6h answered `environment:prod` queries.
    env      = "operations",
    // LOG-STANDARD: `environment` is the cross-signal key (traces' deployment.environment);
    // `env` stays until the naming migration (ADR-0010) drops it.
    environment = "operations",
  }
}
