// =============================================================================
// homelab (Mac mini) SELF-monitoring collector — runs as a CONTAINER on colima.
//
// The DGX collector can't run here (it's Linux: network_mode host, /rootfs, DCGM).
// On macOS the split is:
//   • macOS HOST metrics (cpu/mem/DISK/load) → a NATIVE node_exporter (brew) on
//     :9100, reached from this container via host.docker.internal. A container
//     CANNOT see real macOS host stats (it sees the colima Linux VM), so the
//     host exporter MUST run natively — see README.
//   • CONTAINER logs (the whole observability stack) → Docker socket.
// Writes to the LOCAL backend on the same box (host.docker.internal published
// ports). No tailnet / no ACL — everything is loopback-local.
//
// ⚠ EDITING CAVEAT — this file is a SINGLE-FILE bind mount
// (docker-compose.yml: ./config.alloy:/etc/alloy/config.alloy:ro). Editing it
// IN PLACE is fine (Alloy hot-reloads). But REPLACING the file (scp/mv/rsync →
// new inode) breaks the bind mount — the container keeps the old inode and the
// new content is never seen. After any scp/mv of this file you MUST
// `docker restart alloy-homelab` to re-bind. (Edit-in-place with sed/an editor
// avoids this; a whole-file copy does not.)
// =============================================================================

// ---------- HOST: macOS via native node_exporter ----------
prometheus.scrape "node" {
  targets         = [{ __address__ = "host.docker.internal:9100", instance = "homelab" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "node"
  scrape_interval = "30s"
}

// ---------- LiteLLM stack health: postgres-exporter ----------
// LiteLLM's own /metrics is enterprise-gated (401), so the stack's postgres-
// exporter sidecar is the health probe. Feeds up{job="litellm-postgres"}, which
// the "LiteLLM gateway down" alert (rules.yaml) watches as a dead-man's switch —
// without this scrape the metric is absent and the alert fires false NoData.
// Scraped VM-INTERNALLY by container name over the litellm docker network (alloy
// joins litellm_default — see docker-compose.yml), NOT via the host's forwarded
// :9189. host.docker.internal round-trips through lima's SSH forward, which dies
// on any network transition (see recipes/colima-lima-forwarding-recovery.md) —
// that break once vanished this metric and false-fired the gateway-down alert.
prometheus.scrape "litellm_postgres" {
  targets         = [{ __address__ = "litellm-postgres-exporter:9187", instance = "homelab" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "litellm-postgres"
  scrape_interval = "30s"
}

// ---------- VictoriaTraces' own counters (trace intake freshness) ----------
// Nothing showed whether traces still ARRIVE: prod's apis push OTLP straight to the mini
// (:10428, no TLS node, no Alloy in between), so a broken path is silent. VictoriaTraces
// counts what it ingests (vt_bytes_ingested_total{type="opentelemetry_traces_otlphttp_protobuf"});
// alert ingest-traces-stalled fires when it stops growing. Container name, same network
// as victoriametrics/victorialogs. Added 2026-11-01 (post-outage ingest review).
prometheus.scrape "victoriatraces_self" {
  targets         = [{ __address__ = "victoriatraces:10428", instance = "homelab", service = "victoriatraces" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "victoriatraces"
  scrape_interval = "60s"
}

// ---------- Langfuse datastores (redis + postgres) ----------
// Both exporters had been up 8 days serving /metrics that NOTHING scraped: a check for
// `redis_*` in VictoriaMetrics returned ZERO series, so the LLM-observability stack's own
// datastores were the one unmonitored corner of the estate. Found 2026-09-18 while chasing
// the langfuse-worker socket-timeout noise — the tell was having to curl the exporter by
// hand because there was no series to query.
//
// Container names over langfuse_default, NOT the host's :9122/:9188 forwards, for the same
// lima-fragility reason as litellm_postgres above.
//
// `redis_connected_clients` is the one worth watching: langfuse#13601 reports the
// socket-timeout watchdog leaking connections to 87+. Ours reads 96 — in that range, but
// FLAT over the minutes observed, and a leak only shows as monotonic growth over hours.
// UNRESOLVED on purpose: langfuse opens a blocking connection per BullMQ queue and there
// are 15+, so 96 may simply be its pool. This scrape is what makes the question answerable
// at all; before it, no `redis_*` series existed anywhere.
//
// ⚠ Check it via the SERIES, not by hand. Host :9121 is GLITCHTIP's exporter (5 clients);
// langfuse's is remapped to :9122, and both report `9121/tcp` container-side. That trap
// produced a confidently wrong "we are not leaking" reading on 2026-09-18.
//
// Note redis_connections_received_total is NOT a leak signal here: ~21.8/min is this
// stack's own 3s `redis-cli ping` healthcheck, unchanged before and after the watchdog fix.
prometheus.scrape "langfuse_redis" {
  targets         = [{ __address__ = "langfuse-redis-exporter-1:9121", instance = "homelab" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "langfuse-redis"
  scrape_interval = "30s"
}

prometheus.scrape "langfuse_postgres" {
  targets         = [{ __address__ = "langfuse-postgres-exporter-1:9187", instance = "homelab" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "langfuse-postgres"
  scrape_interval = "30s"
}

// ---------- Delivery workers (podcast_scraper #1412 / ADR-144) ----------
// Each delivery loop exposes Prometheus /metrics (email 9110 / push 9111 / events 9112).
// Feeds the delivery_* series the "Delivery worker" Grafana board reads (bounce-rate =
// the deliverability canary). Logs are already captured by the generic container source
// below. Source of truth: chipi/infra/infra/observability/delivery.alloy.
// Scraped VM-INTERNALLY by container name over the delivery docker network (alloy joins
// delivery_default — see docker-compose.yml), NOT via the host's forwarded :9110-9112,
// so the board survives a lima forward break (see the litellm_postgres note above).
prometheus.scrape "delivery" {
  targets = [
    { __address__ = "delivery-email:9110", instance = "homelab", channel = "email" },
    { __address__ = "delivery-push:9111", instance = "homelab", channel = "push" },
    { __address__ = "delivery-events:9112", instance = "homelab", channel = "events" },
  ]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "delivery"
  scrape_interval = "30s"
}

// ---------- Home Assistant (chipi/home-automation) ----------
// HA's /api/prometheus (its `prometheus:` integration, filtered to the entities worth
// keeping), over home-automation_default by container name. Bearer token: a long-lived HA
// token, HA_PROMETHEUS_TOKEN in this stack's .env on the mini (gitignored).
prometheus.scrape "home_assistant" {
  targets = [{
    __address__ = "home-assistant:8123",
    instance    = "homelab",
    service     = "home-assistant",
    namespace   = "home-automation",
    environment = "prod",
  }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "home-assistant"
  metrics_path    = "/api/prometheus"
  scrape_interval = "60s"
  bearer_token    = sys.env("HA_PROMETHEUS_TOKEN")
}

// ---------- Website probes (outside-in) ----------
// The sites are behind Cloudflare; edge-caddy-5xx-burst only sees errors that reach the prod
// Caddy. These GET each public URL from the home internet, through Cloudflare like a visitor,
// so a deleted DNS record, a Cloudflare-side outage or a missing vhost shows too. Alloy's
// embedded blackbox exporter, no extra container. Alert: site-probe-failing (rules.yaml),
// gated on the mini's own egress so a mini network outage does not read as every site down.
prometheus.exporter.blackbox "sites" {
  config = `
modules:
  page_humancopilot:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [200]
      fail_if_body_not_matches_regexp: ["<title>[^<]*Human Copilot"]
  page_devwhateverops:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [200]
      fail_if_body_not_matches_regexp: ["<title>[^<]*DevWhateverOps"]
  http_200:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [200]
  http_404:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [404]
  page_orrery:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [200]
      fail_if_body_not_matches_regexp: ["<title>[^<]*Orrery"]
  cl_api:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [200]
      fail_if_body_not_matches_regexp: ["\"auth_ready\":\\s*true"]
  json_ok:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [200]
      fail_if_body_not_matches_regexp: ["\"ok\":\\s*true"]
  mcp_unauth:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      method: POST
      headers:
        Content-Type: application/json
      body: "{}"
      valid_status_codes: [401]
      fail_if_body_not_matches_regexp: ["unauthorized"]
  glitchtip_ingest:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [405]
      fail_if_body_not_matches_regexp: ["Method not allowed"]
  umami_send:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      method: POST
      headers:
        Content-Type: application/json
      body: "{}"
      valid_status_codes: [400]
      fail_if_body_not_matches_regexp: ["\"code\":\\s*\"bad-request\""]
`

  target {
    name    = "www.humancopilot.eu"
    address = "https://www.humancopilot.eu/"
    module  = "page_humancopilot"
  }
  target {
    name    = "www.devwhateverops.com"
    address = "https://www.devwhateverops.com/"
    module  = "page_devwhateverops"
  }
  // GlitchTip ingest hosts: a GET on an ingest path is answered 405 by GlitchTip itself
  // (Caddy alone answers 404), so this proves the edge -> Caddy -> GlitchTip path without
  // sending an event. telemetry.humancopilot.eu routes only /api/<n>/security/.
  target {
    name    = "telemetry.humancopilot.eu"
    address = "https://telemetry.humancopilot.eu/api/36/security/"
    module  = "glitchtip_ingest"
  }
  target {
    name    = "telemetry.closelistening.app"
    address = "https://telemetry.closelistening.app/api/1/envelope/"
    module  = "glitchtip_ingest"
  }
  target {
    name    = "telemetry.orrerylearn.com"
    address = "https://telemetry.orrerylearn.com/api/1/envelope/"
    module  = "glitchtip_ingest"
  }
  // Close Listening: the apps' API (the unauthenticated / is a static coming-soon page and
  // proves nothing about the backend). operator.closelistening.app is behind a login and
  // has no unauthenticated backend path, so it is not probed.
  target {
    name    = "closelistening.app"
    address = "https://closelistening.app/api/app/auth/status"
    module  = "cl_api"
  }
  // MCP servers: an unauthenticated POST /mcp must be refused by the server (401 JSON).
  target {
    name    = "mcp.closelistening.app"
    address = "https://mcp.closelistening.app/mcp"
    module  = "mcp_unauth"
  }
  target {
    name    = "obs.closelistening.app"
    address = "https://obs.closelistening.app/mcp"
    module  = "mcp_unauth"
  }
  target {
    name    = "www.orrerylearn.com"
    address = "https://www.orrerylearn.com/"
    module  = "page_orrery"
  }
  target {
    name    = "lab-api.orrerylearn.com"
    address = "https://lab-api.orrerylearn.com/health"
    module  = "json_ok"
  }
  target {
    name    = "mcp.orrerylearn.com"
    address = "https://mcp.orrerylearn.com/health"
    module  = "json_ok"
  }
  // Umami tracker hosts: an empty POST /api/send must be refused by Umami itself (400
  // bad-request, nothing stored). Not GET /script.js: Cloudflare caches it for 24h, so on
  // 2026-10-31/11-01 the script probes kept passing on the cached copy while every send got
  // 502 for ~14h (prod had lost its tailnet path to the umami node); orrery's never failed.
  target {
    name    = "analytics.closelistening.app"
    address = "https://analytics.closelistening.app/api/send"
    module  = "umami_send"
  }
  target {
    name    = "analytics.orrerylearn.com"
    address = "https://analytics.orrerylearn.com/api/send"
    module  = "umami_send"
  }
  target {
    name    = "analytics.humancopilot.eu"
    address = "https://analytics.humancopilot.eu/api/send"
    module  = "umami_send"
  }
  target {
    name    = "analytics.markodragoljevic.com"
    address = "https://analytics.markodragoljevic.com/api/send"
    module  = "umami_send"
  }
  target {
    name    = "analytics.airandspacehistory.com"
    address = "https://analytics.airandspacehistory.com/api/send"
    module  = "umami_send"
  }
  target {
    name    = "evals.humancopilot.eu"
    address = "https://evals.humancopilot.eu/"
    module  = "http_200"
  }
  target {
    name    = "www.markodragoljevic.com"
    address = "https://www.markodragoljevic.com/"
    module  = "http_200"
  }
  target {
    name    = "airandspacehistory.com"
    address = "https://airandspacehistory.com/"
    module  = "http_200"
  }
}

discovery.relabel "sites" {
  targets = prometheus.exporter.blackbox.sites.targets
  rule {
    source_labels = ["__param_target"]
    regex         = "https?://([^/]+).*"
    target_label  = "host"
  }
  rule {
    target_label = "instance"
    replacement  = "homelab"
  }
  rule {
    target_label = "service"
    replacement  = "site-probe"
  }
  // the exporter's targets carry job="integrations/blackbox/<name>", which wins over job_name
  rule {
    target_label = "job"
    replacement  = "site-probe"
  }
}

prometheus.scrape "sites" {
  targets         = discovery.relabel.sites.output
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "site-probe"
  scrape_interval = "60s"
}

// ---------- The X3 assistant (RFC-0008, infra/x3/ollama-assistant.service) ----------
// Green only when the assistant model is loaded (Ollama's /api/ps lists it), not merely when the
// port answers: an empty /api/ps means the first chat waits for a load, or the X3 is out of GPU
// memory. The mini is the only tailnet source the ACL lets reach 100.92.54.65:11435.
// Alert: x3-assistant-down (rules.yaml); LiteLLM's assistant alias fails over meanwhile.
prometheus.exporter.blackbox "assistant" {
  config = `
modules:
  model_loaded:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [200]
      fail_if_body_not_matches_regexp: ["qwen3:30b-a3b-instruct-2507"]
`
  target {
    name    = "x3-assistant"
    address = "http://100.92.54.65:11435/api/ps"
    module  = "model_loaded"
  }
}

discovery.relabel "assistant" {
  targets = prometheus.exporter.blackbox.assistant.targets
  rule {
    target_label = "instance"
    replacement  = "x3"
  }
  rule {
    target_label = "service"
    replacement  = "assistant"
  }
  rule {
    target_label = "job"
    replacement  = "assistant-probe"
  }
}

prometheus.scrape "assistant" {
  targets         = discovery.relabel.assistant.output
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "assistant-probe"
  scrape_interval = "60s"
}

// NOTE: cAdvisor was tried here for per-container cpu/mem/io but doesn't work on
// colima (cgroup v2 + cgroupfs + cgroupns — it only sees system/systemd cgroups, not
// the docker container scopes). Covered instead by an inline `docker stats` block in
// mini-metrics/push.sh → mini_container_cpu_percent / mini_container_mem_bytes, keyed
// by container NAME.

// ---------- LOGS: all docker container stdout/stderr ----------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.relabel.service.receiver]
}

// service = the container name without compose's replica suffix (glitchtip-worker-1 ->
// glitchtip-worker); for the delivery workers it equals their OTel service.name.
// Set HERE, after the source, never in discovery.relabel: loki.source.docker keys its
// read positions by the target's labels, so a new target label makes every container
// a new target and re-reads its whole docker log (2026-10-14: ~30 days replayed as
// duplicates before this was moved).
loki.relabel "service" {
  rule {
    source_labels = ["container"]
    regex         = "(.+?)(-[0-9]+)?"
    target_label  = "service"
  }
  // The home-automation stack (home-assistant, mosquitto) is a home system, not the
  // stack's own operations: its compose labels say telemetry.namespace=home-automation, telemetry.environment=prod. The generic
  // telemetry.* rule (ADR-0010 phase B) isn't on the mini: container labels exist only as
  // target labels, and a new target label replays every container's log. A per-line
  // label wins over loki.write's external_labels (tested 2026-10-27, alloy v1.17.0).
  rule {
    source_labels = ["container"]
    regex         = "home-assistant|mosquitto"
    target_label  = "namespace"
    replacement   = "home-automation"
  }
  rule {
    source_labels = ["container"]
    regex         = "home-assistant|mosquitto"
    target_label  = "environment"
    replacement   = "prod"
  }
  forward_to = [loki.process.homelab_std.receiver]
}

// ---------- homelab log standard: trace_id -> structured_metadata ----------
// See infra/observability/LOG-STANDARD.md. Extracts the 32-hex trace id into
// structured_metadata (a queryable field, not a high-cardinality stream label)
// from every shape the apps write: `trace_id=<id>` (OTel log correlation),
// `"trace_id":"<id>"` (JSON events, e.g. delivery), `trace=<id>` (access log,
// pipeline), and traceparent / sentry-trace headers. Same pattern as the Grafana
// VictoriaLogs derived field — keep the two identical.
loki.process "homelab_std" {
  // Secret redaction, every container: a LiteLLM or OpenRouter key (`sk-...`) never
  // reaches VictoriaLogs, which keeps 30 days and cannot delete. LiteLLM's access log
  // prints full URLs, and `/key/info?key=sk-...` put 4 keys there before 2026-11-01.
  // The minimum length leaves words like `sk-learn` alone; the word boundary leaves
  // topic ids like `topic:risk-...` and `task-...` alone (they contain "sk-", and the
  // unbounded first version rewrote them, 2026-11-01).
  stage.replace {
    expression = "\\b(sk-[A-Za-z0-9_-]{16,})"
    replace    = "sk-REDACTED"
  }

  // flotilla (flotillad, its workers, its egress proxy) logs one JSON object per line with the
  // message in `msg`; VictoriaLogs looks for `_msg`, so every flotilla line read "missing _msg
  // field" (found 2026-11-11). Add a `_msg`: the message, then the routine, run and status when
  // present (ids and constant words, never error text, so no quote can break the JSON). Every
  // key stays a field; a line that is not a JSON object is left as it is. Same shape as the
  // podcast drop-in (LOG-STANDARD, event lines).
  stage.match {
    selector = "{container=~\"flotillad|flotilla-.+\"} |~ \"^\\\\{.*\\\"msg\\\" ?:\""

    stage.regex {
      expression = "^(?P<fl_json>\\{.*\\})\\s*$"
    }
    stage.json {
      source      = "fl_json"
      expressions = {fl_msg = "msg", fl_routine = "routine", fl_run = "run_id", fl_status = "status"}
    }
    stage.template {
      source   = "fl_json"
      template = "{{ TrimSuffix .Value \"}\" }}, \"_msg\": \"{{ .fl_msg }}{{ with .fl_routine }} routine={{ . }}{{ end }}{{ with .fl_run }} run={{ . }}{{ end }}{{ with .fl_status }} status={{ . }}{{ end }}\"}"
    }
    stage.output {
      source = "fl_json"
    }
  }

  // Alloy's own graph-evaluation logs carry a `trace_id=` for traces it never
  // exports; skip its container so they don't get a dead trace_id field.
  stage.match {
    selector = "{container!~\"alloy.*\"}"

    stage.regex {
      expression = "(?:trace_id[=\":\\s]+|trace=|00-|sentry-trace[=\":\\s]+)(?P<trace_id>[a-f0-9]{32})"
    }
    stage.structured_metadata {
      values = { trace_id = "" }
    }
  }
  forward_to = [loki.write.local.receiver]
}

// ---------- PUSH: metrics → local VictoriaMetrics ----------
prometheus.remote_write "local" {
  endpoint {
    url = coalesce(sys.env("REMOTE_WRITE_URL"), "http://victoriametrics:8428/api/v1/write")
  }
  external_labels = {
    instance = "homelab",
    cluster  = "homelab",
  }
}

// ---------- PUSH: logs → local VictoriaLogs ----------
loki.write "local" {
  endpoint {
    url = coalesce(sys.env("LOGS_WRITE_URL"), "http://victorialogs:9428/insert/loki/api/v1/push")
  }
  external_labels = {
    instance = "homelab",
    cluster  = "homelab",
    // Everything on the mini is the stack's own self-monitoring, the fleets and the shared
    // gateway: `operations` (ADR-0010, LOG-STANDARD), not the apps' `prod`. Until 2026-10-15
    // this said prod, so ~100k mini lines per 6h answered `environment:prod` queries.
    env      = "operations",
    // LOG-STANDARD: `environment` is the cross-signal key (traces' deployment.environment);
    // `env` stays until the naming migration (ADR-0010) drops it.
    environment = "operations",
  }
}
