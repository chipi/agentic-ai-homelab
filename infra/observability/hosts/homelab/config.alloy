// =============================================================================
// homelab (Mac mini) SELF-monitoring collector — runs as a CONTAINER on OrbStack.
//
// The DGX collector can't run here (it's Linux: network_mode host, /rootfs, DCGM).
// On macOS the split is:
//   • macOS HOST metrics (cpu/mem/DISK/load) → a NATIVE node_exporter (brew) on
//     :9100, reached from this container via host.docker.internal. A container
//     CANNOT see real macOS host stats (it sees the OrbStack Linux VM), so the
//     host exporter MUST run natively — see README.
//   • CONTAINER logs (the whole observability stack) → Docker socket.
// Writes to the LOCAL backend on the same box (host.docker.internal published
// ports). No tailnet / no ACL — everything is loopback-local.
// =============================================================================

// ---------- HOST: macOS via native node_exporter ----------
prometheus.scrape "node" {
  targets         = [{ __address__ = "host.docker.internal:9100", instance = "homelab" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "node"
  scrape_interval = "30s"
}

// ---------- LiteLLM stack health: postgres-exporter ----------
// LiteLLM's own /metrics is enterprise-gated (401), so the stack's postgres-
// exporter sidecar is the health probe. Published on the host at :9189 (reached
// like node, via host.docker.internal). Feeds up{job="litellm-postgres"}, which
// the "LiteLLM gateway down" alert (rules.yaml) watches as a dead-man's switch —
// without this scrape the metric is absent and the alert fires false NoData.
prometheus.scrape "litellm_postgres" {
  targets         = [{ __address__ = "host.docker.internal:9189", instance = "homelab" }]
  forward_to      = [prometheus.remote_write.local.receiver]
  job_name        = "litellm-postgres"
  scrape_interval = "30s"
}

// ---------- LOGS: all docker container stdout/stderr ----------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.homelab_std.receiver]
}

// ---------- homelab log standard: trace_id -> structured_metadata ----------
// See infra/observability/LOG-STANDARD.md. Extracts the 32-hex trace id from a
// traceparent / sentry-trace pattern into structured_metadata (a queryable
// field, not a high-cardinality stream label). Infra logs here rarely carry
// trace context, but the standard is applied uniformly on every Alloy.
loki.process "homelab_std" {
  stage.regex {
    expression = "(?:00-)?(?P<trace_id>[a-f0-9]{32})-[a-f0-9]{16}"
  }
  stage.structured_metadata {
    values = { trace_id = "" }
  }
  forward_to = [loki.write.local.receiver]
}

// ---------- PUSH: metrics → local VictoriaMetrics ----------
prometheus.remote_write "local" {
  endpoint {
    url = coalesce(sys.env("REMOTE_WRITE_URL"), "http://host.docker.internal:8428/api/v1/write")
  }
  external_labels = {
    instance = "homelab",
    cluster  = "homelab",
  }
}

// ---------- PUSH: logs → local VictoriaLogs ----------
loki.write "local" {
  endpoint {
    url = coalesce(sys.env("LOGS_WRITE_URL"), "http://host.docker.internal:9428/insert/loki/api/v1/push")
  }
  external_labels = {
    instance = "homelab",
    cluster  = "homelab",
    env      = "prod",
  }
}
