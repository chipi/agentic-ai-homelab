# VPS (prod-podcast) collector -> self-hosted backend on the Mac mini (tailnet).
# Copy to `.env` on the box (/opt/vps-observability/.env). No secrets here —
# VictoriaMetrics/VictoriaLogs ignore auth on the tailnet.
#
# Metrics -> VictoriaMetrics ; logs -> VictoriaLogs, both on the mini. These two are
# the ONLY backend references for this collector (config.alloy reads them via sys.env
# — no hardcoded IP in the .alloy).
# (The DGX→mini backend migration is done; these used to point at `dgx-llm-1`.)
#
# Go through the mini's Caddy TAILNET ingress, not the container ports directly. Both
# routes reach the same backend — `https://vm.tail6d0ed4.ts.net` is just
# `reverse_proxy victoriametrics:8428` — so this is a routing choice, not a security
# one: every vhost in that Caddyfile is `bind tailscale`, and the whole path is inside
# WireGuard either way. Reasons for the ingress: it is the documented service address
# (infra/README.md), it matches what the DGX collector already uses, and it keeps one
# name to change if a backend ever moves off :8428.
#
# Cost, so it is not a surprise: this puts Caddy in the metrics write path. If Caddy on
# the mini is down, this collector stops shipping even when VictoriaMetrics is fine.
# The direct form is the fallback and was verified reachable from prod:
#   REMOTE_WRITE_URL=http://homelab:8428/api/v1/write
#   LOGS_WRITE_URL=http://homelab:9428/insert/loki/api/v1/push
#
# Verified from prod 2026-09-16: vm. -> http 200, tls ok; vlogs. -> tls ok. See #64.
REMOTE_WRITE_URL=https://vm.tail6d0ed4.ts.net/api/v1/write
LOGS_WRITE_URL=https://vlogs.tail6d0ed4.ts.net/insert/loki/api/v1/push

# Per-deploy identity — distinct from the DGX so series don't collide.
HOMELAB_INSTANCE=prod-podcast
HOMELAB_CLUSTER=vps

# Grafana Cloud vars are unused on the tailnet (VM/VL ignore auth) but the
# config's remote_write block still reads them — leave any dummy value.
GRAFANA_CLOUD_PROM_URL=unused
GRAFANA_CLOUD_PROM_USERNAME=unused
GRAFANA_CLOUD_PROM_API_KEY=unused
