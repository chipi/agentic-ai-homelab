# Copy to .env (gitignored). Point the collector at the self-hosted backend:
#
# The backend lives on the Mac mini (`homelab`) — the DGX→mini migration is
# done. Set both keys to `homelab` (Tailscale device name, resolves tailnet-
# wide); config.alloy reads them via sys.env — no hardcoded IP in the .alloy:
#   REMOTE_WRITE_URL=http://homelab:8428/api/v1/write
#   LOGS_WRITE_URL=http://homelab:9428/insert/loki/api/v1/push
# (A same-host collector on the mini can use localhost / host.docker.internal.)
# No auth needed on the tailnet.
#
# LEGACY FALLBACK (Grafana Cloud): the config still supports pushing to Grafana
# Cloud if REMOTE_WRITE_URL is left unset (fill GRAFANA_CLOUD_PROM_* below). This
# path is retired in this homelab — kept only because config.alloy still reads
# the vars; leave a dummy value.
GRAFANA_CLOUD_PROM_URL=unused
GRAFANA_CLOUD_PROM_USERNAME=1234567
GRAFANA_CLOUD_PROM_API_KEY=glc_eyJxxxxxxxxx

# --- Logs (VictoriaLogs, in backend/) -----------------------------------
# Where container/host logs are pushed (Loki push protocol). Point at the
# backend host's tailnet IP. Unset = http://localhost:9428 (same-host only).
# LOGS_WRITE_URL=http://100.x.y.z:9428/insert/loki/api/v1/push

# Per-deploy identity labels (applied to every metric pushed):
#   HOMELAB_INSTANCE — per-target instance label (e.g., your host name)
#   HOMELAB_CLUSTER  — logical group label (filter on this in Grafana queries)
HOMELAB_INSTANCE=homelab-1
HOMELAB_CLUSTER=homelab
