    {
      "id": 901,
      "title": "Delivered 24h",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(delivery_sent_total{tenant=\"podcast\",status=\"delivered\"}[24h]))"
        }
      ]
    },
    {
      "id": 902,
      "title": "Bounce+complaint 1h",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(delivery_sent_total{tenant=\"podcast\",status=~\"bounced|complaint\"}[1h])) / clamp_min(sum(rate(delivery_sent_total{tenant=\"podcast\",status=~\"delivered|bounced|complaint\"}[1h])), 1)"
        }
      ]
    },
    {
      "id": 903,
      "title": "Dead-letters 24h",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
