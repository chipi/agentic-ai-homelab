            "uid": "victoriametrics"
          },
          "expr": "DCGM_FI_DEV_GPU_TEMP{gpu=~\"$gpu\"}",
          "legendFormat": "gpu{{gpu}} core"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "DCGM_FI_DEV_MEMORY_TEMP{gpu=~\"$gpu\"}",
