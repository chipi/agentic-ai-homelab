{
  "uid": "second-brain",
  "title": "second-brain — the paper library's read server",
  "tags": ["second-brain", "mcp", "flotilla"],
  "description": "sb serve (github.com/chipi/second-brain) on the mini as sb-mcp, the read server flotilla's reads worker calls (infra/second-brain). Scraped by alloy-homelab over the mcp network; the weekly build pushes its own metrics. Alerts: second-brain-build-stale, second-brain-mcp-errors, infra-target-down.",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "sb-mcp up",
      "description": "1 when Alloy's last scrape of sb-mcp:8790/metrics answered.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "max(up{job=\"second-brain\"})", "instant": true, "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" } }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 2, "type": "stat", "title": "Papers in the served index",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "targets": [{ "expr": "max(sb_index_papers{job=\"second-brain\"})", "instant": true, "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" } }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3, "type": "stat", "title": "Chunks in the served index",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "targets": [{ "expr": "max(sb_index_chunks{job=\"second-brain\"})", "instant": true, "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" } }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4, "type": "stat", "title": "Served index built",
      "description": "Age of the index DATA/current points at (sb_index_built_timestamp_seconds, from the server).",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "targets": [{ "expr": "time() - max(sb_index_built_timestamp_seconds{job=\"second-brain\"})", "instant": true, "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" } }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 691200 }] } }, "overrides": [] }
    },
    {
      "id": 5, "type": "stat", "title": "Last weekly build",
      "description": "Age of the last build update.sh completed and pushed (sb_build_last_success_timestamp_seconds). Over 8 days fires second-brain-build-stale.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "targets": [{ "expr": "time() - max(last_over_time(sb_build_last_success_timestamp_seconds{job=\"second-brain\"}[30d]))", "instant": true, "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" } }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 691200 }] } }, "overrides": [] }
    },
    {
      "id": 6, "type": "timeseries", "title": "Requests by tool and status",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum by (tool, status) (increase(sb_requests_total{job=\"second-brain\"}[$__rate_interval]))", "legendFormat": "{{tool}} {{status}}", "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" } }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 7, "type": "timeseries", "title": "Request duration p95 by tool",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (tool, le) (rate(sb_request_duration_seconds_bucket{job=\"second-brain\"}[$__rate_interval])))", "legendFormat": "{{tool}}", "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" } }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 8, "type": "timeseries", "title": "Weekly build: papers, chunks, fetch failures",
      "description": "Pushed by update.sh after each run (sb_build_papers, sb_build_chunks, sb_fetch_failures).",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "max(sb_build_papers{job=\"second-brain\"})", "legendFormat": "papers", "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" } },
        { "expr": "max(sb_build_chunks{job=\"second-brain\"})", "legendFormat": "chunks", "refId": "B", "datasource": { "type": "prometheus", "uid": "victoriametrics" } },
        { "expr": "max(sb_fetch_failures{job=\"second-brain\"})", "legendFormat": "fetch failures", "refId": "C", "datasource": { "type": "prometheus", "uid": "victoriametrics" } }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Full texts by kind",
      "description": "Every cached text by source_kind after the last fulltext run (sb_fulltext_papers).",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "max by (kind) (sb_fulltext_papers{job=\"second-brain\"})", "legendFormat": "{{kind}}", "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" } }]
    }
  ]
}
