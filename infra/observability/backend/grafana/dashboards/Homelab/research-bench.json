{
  "uid": "research-bench",
  "title": "Research bench \u2014 local models (DGX, X3, MacBook)",
  "description": "What a local-model run needs next to its results: per-host model speed from the Ollama log, GPU, memory and pressure. Hosts: dgx-llm-1, x3, macbook.",
  "tags": [
    "research",
    "ollama",
    "dgx",
    "workstation"
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "custom",
        "query": "dgx-llm-1,x3,macbook",
        "multi": true,
        "includeAll": true,
        "allValue": "dgx-llm-1|x3|macbook",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Model speed (from each host's Ollama log)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Generation speed (tokens/s)",
      "description": "llama.cpp's per-request generation rate, averaged per host per interval. MacBook runs use speculative decoding (draft acceptance in its log).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "job:\"ollama\" instance:~\"$host\" \"print_timing\" | extract_regexp \"tg = +(?P<tg>[0-9.]+) t/s\" | stats by (instance) avg(tg) tg",
          "queryType": "statsRange"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "points",
            "pointSize": 4,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Prompt processing (tokens/s)",
      "description": "",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "job:\"ollama\" instance:~\"$host\" \"prompt eval time\" | extract_regexp \"(?P<pp>[0-9.]+) tokens per second\" | stats by (instance) avg(pp) pp",
          "queryType": "statsRange"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "points",
            "pointSize": 4,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Model loads (llama-server starts)",
      "description": "Each start is a model (re)load; the DGX loads gpt-oss:120b etc. from the shared blob store.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "job:\"ollama\" instance:~\"$host\" \"starting llama-server\" | stats by (instance) count() loads",
          "queryType": "statsRange"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "points",
            "pointSize": 4,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Ollama errors / OOM / offload lines",
      "description": "",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "job:\"ollama\" instance:~\"$host\" (\"level=ERROR\" OR \"out of memory\" OR \"offload\" OR \"failed\") | stats by (instance) count() lines",
          "queryType": "statsRange"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "points",
            "pointSize": 4,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Ollama log volume",
      "description": "",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "job:\"ollama\" instance:~\"$host\" | stats by (instance) count() lines",
          "queryType": "statsRange"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "points",
            "pointSize": 4,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      }
    },
    {
      "type": "row",
      "title": "Machine",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "GPU busy %",
      "description": "DGX: dcgm. X3: the kernel's amdgpu busy counter (drm collector). MacBook: not available without root.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "DCGM_FI_DEV_GPU_UTIL{instance=~\"$host\"}",
          "legendFormat": "{{instance}} (NVIDIA)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "node_drm_gpu_busy_percent{instance=~\"$host\"}",
          "legendFormat": "{{instance}} (AMD)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "timeseries",
      "title": "Memory available",
      "description": "Unified memory on all three: the model's weights and KV cache come out of this.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "node_memory_MemAvailable_bytes{instance=~\"$host\"}",
          "legendFormat": "{{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "(node_memory_free_bytes{instance=~\"$host\"} + node_memory_inactive_bytes{instance=~\"$host\"})",
          "legendFormat": "{{instance}} (macOS free+inactive)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      }
    },
    {
      "type": "timeseries",
      "title": "Memory pressure (PSI, share of time stalled)",
      "description": "Linux only. Rising pressure while a model serves means it no longer fits.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(node_pressure_memory_waiting_seconds_total{instance=~\"$host\"}[2m])",
          "legendFormat": "{{instance}} waiting"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(node_pressure_memory_stalled_seconds_total{instance=~\"$host\"}[2m])",
          "legendFormat": "{{instance}} stalled"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      }
    },
    {
      "type": "timeseries",
      "title": "CPU busy",
      "description": "High CPU with low GPU during a run = layers offloaded to the CPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{instance=~\"$host\", mode=\"idle\"}[2m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      }
    },
    {
      "type": "timeseries",
      "title": "GPU power (W) and temperature (C)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "DCGM_FI_DEV_POWER_USAGE{instance=~\"$host\"}",
          "legendFormat": "{{instance}} W"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "DCGM_FI_DEV_GPU_TEMP{instance=~\"$host\"}",
          "legendFormat": "{{instance}} C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      }
    },
    {
      "type": "timeseries",
      "title": "Loaded model and its memory (DGX sidecar)",
      "description": "From the ollama-metrics sidecar (DGX only; X3 and MacBook have no Docker). Model names per load are in the log panel below.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "ollama_model_ram_mb{instance=~\"$host\"} * 1024 * 1024",
          "legendFormat": "{{instance}} {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      }
    },
    {
      "type": "timeseries",
      "title": "Swap used",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "node_memory_SwapTotal_bytes{instance=~\"$host\"} - node_memory_SwapFree_bytes{instance=~\"$host\"}",
          "legendFormat": "{{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "node_memory_swap_used_bytes{instance=~\"$host\"}",
          "legendFormat": "{{instance}} (macOS)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      }
    },
    {
      "type": "row",
      "title": "Ollama log",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Ollama log (loads, memory, errors; per-request timing lines excluded)",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "job:\"ollama\" instance:~\"$host\" -\"print_timing\" -\"slot \" -\"[GIN]\"",
          "queryType": "instant"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 43
      }
    }
  ]
}