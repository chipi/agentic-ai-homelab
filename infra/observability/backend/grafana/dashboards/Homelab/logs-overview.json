{
  "uid": "logs-overview",
  "title": "Logs \u2014 Overview",
  "tags": [
    "logs",
    "victorialogs"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "",
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "label": "Host",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "instance",
          "limit": 50,
          "refId": "VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "env",
        "type": "query",
        "label": "Env",
        "description": "Deployment environment (prod / staging / dev / ci) — the standard stream label that separates e.g. podcast staging from prod. See LOG-STANDARD.md.",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "env",
          "limit": 20,
          "refId": "VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "app",
        "type": "query",
        "label": "Application",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "app",
          "limit": 200,
          "refId": "VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "severity",
        "type": "custom",
        "label": "Severity",
        "description": "Pattern-matched over the message — works across every log format (redis/caddy/go/json), unlike the thin structured 'level' field.",
        "query": "All : .*,Warnings & errors : (error|Error|ERROR|err|Err|ERR|warn|Warn|WARN|fatal|Fatal|FATAL|panic|Panic|PANIC|exception|Exception|EXCEPTION|traceback|Traceback|TRACEBACK|fail|Fail|FAIL|critical|Critical|CRITICAL),Errors only : (error|Error|ERROR|fatal|Fatal|FATAL|panic|Panic|PANIC|exception|Exception|EXCEPTION|traceback|Traceback|TRACEBACK|critical|Critical|CRITICAL)",
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "All",
          "value": ".*"
        },
        "options": [
          {
            "text": "All",
            "value": ".*",
            "selected": true
          },
          {
            "text": "Warnings & errors",
            "value": "(error|Error|ERROR|err|Err|ERR|warn|Warn|WARN|fatal|Fatal|FATAL|panic|Panic|PANIC|exception|Exception|EXCEPTION|traceback|Traceback|TRACEBACK|fail|Fail|FAIL|critical|Critical|CRITICAL)",
            "selected": false
          },
          {
            "text": "Errors only",
            "value": "(error|Error|ERROR|fatal|Fatal|FATAL|panic|Panic|PANIC|exception|Exception|EXCEPTION|traceback|Traceback|TRACEBACK|critical|Critical|CRITICAL)",
            "selected": false
          }
        ]
      },
      {
        "name": "container",
        "type": "query",
        "label": "Container",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "container",
          "limit": 200,
          "refId": "VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Search (LogsQL)",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Total log lines",
      "description": "Number of log lines matching the filters over the dashboard's time range. A sudden drop can mean a service stopped logging; a jump, a burst of activity or errors.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "instance:~\"${host:regex}\" env:~\"${env:regex}\" app:~\"${app:regex}\" container:~\"${container:regex}\" _msg:~\"${severity}\" ${search} | stats count() logs",
          "queryType": "stats"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Errors & warnings",
      "description": "Shows the total number of log entries containing error, warning, or failure-related keywords. A rising count indicates increasing issues, while a stable or decreasing count suggests improving system stability.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "instance:~\"${host:regex}\" env:~\"${env:regex}\" app:~\"${app:regex}\" container:~\"${container:regex}\" _msg:~\"${severity}\" ${search} _msg:~\"(error|Error|ERROR|err|Err|ERR|warn|Warn|WARN|fatal|Fatal|FATAL|panic|Panic|PANIC|exception|Exception|EXCEPTION|traceback|Traceback|TRACEBACK|fail|Fail|FAIL)\" | stats count() logs",
          "queryType": "stats"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Top containers by volume", "description": "The 20 containers with the most log lines over the dashboard's time range. A container far above its usual place is logging unusually much.", "transformations": [{ "id": "labelsToFields", "options": { "mode": "columns", "valueLabel": "__name__" } }, { "id": "merge", "options": {} }, { "id": "organize", "options": { "excludeByName": { "Time": true } } }], 
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "instance:~\"${host:regex}\" env:~\"${env:regex}\" app:~\"${app:regex}\" container:~\"${container:regex}\" _msg:~\"${severity}\" ${search} | stats by (container) count() logs | sort by (logs desc) | limit 20",
          "queryType": "stats"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 4,
      "title": "Log volume by container",
      "description": "Log lines per container in each time bucket. A spike in one container points at a burst of activity or errors in that service.",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "instance:~\"${host:regex}\" env:~\"${env:regex}\" app:~\"${app:regex}\" container:~\"${container:regex}\" _msg:~\"${severity}\" ${search} | stats by (container) count() logs",
          "queryType": "statsRange",
          "legendFormat": "{{container}}",
          "step": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Errors & warnings over time",
      "description": "Log lines containing error, warning or fatal keywords in each time bucket. A rise shows when problems started.",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "instance:~\"${host:regex}\" env:~\"${env:regex}\" app:~\"${app:regex}\" container:~\"${container:regex}\" _msg:~\"${severity}\" ${search} _msg:~\"(error|Error|ERROR|err|Err|ERR|warn|Warn|WARN|fatal|Fatal|FATAL|panic|Panic|PANIC|exception|Exception|EXCEPTION|traceback|Traceback|TRACEBACK|fail|Fail|FAIL)\" | stats count() logs",
          "queryType": "statsRange",
          "legendFormat": "errors+warns",
          "step": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "title": "Live logs",
      "description": "Shows real-time log messages filtered by host, environment, application, container, severity, and custom search terms. A high volume of logs or a sudden spike may indicate increased activity or potential issues, while a sudden drop could mean missing data or a system outage.",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "instance:~\"${host:regex}\" env:~\"${env:regex}\" app:~\"${app:regex}\" container:~\"${container:regex}\" _msg:~\"${severity}\" ${search}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "prettifyLogMessage": false
      }
    }
  ]
}