  "tags": [
    "signal-fleet",
    "fleet",
    "operations",
    "workforce"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
