        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Operator Inbox (items & reasons)",
              "url": "/d/sf-inbox/triage-e28094-operator-inbox"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
