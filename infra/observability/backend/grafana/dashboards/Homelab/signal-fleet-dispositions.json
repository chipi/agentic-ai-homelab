{
  "uid": "signal-fleet-disp",
  "title": "Signal-to-Action Fleet — Dispositions",
  "tags": ["signal-fleet", "fleet", "operations"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Dispositions over time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum by (disposition) (count_over_time(signal_fleet_disposition[$__interval]))",
          "legendFormat": "{{disposition}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total by disposition",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "right" }, "reduceOptions": { "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum by (disposition) (count_over_time(signal_fleet_disposition[$__range]))",
          "legendFormat": "{{disposition}}",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "By source",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "right" }, "reduceOptions": { "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum by (source) (count_over_time(signal_fleet_disposition[$__range]))",
          "legendFormat": "{{source}}",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Tune follow-ups (config-enhancement)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum (count_over_time(signal_fleet_disposition{followup=\"1\"}[$__range]))",
          "legendFormat": "follow-ups",
          "instant": true
        }
      ]
    }
  ]
}
