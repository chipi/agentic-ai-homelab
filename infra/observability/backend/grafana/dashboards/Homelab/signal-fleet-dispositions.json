    {
      "type": "stat",
      "title": "Needs your attention",
      "description": "Actionable now: queued bug work + escalations (7d). Same number as the hub card \"Needs you\". config-enhancement and cleanup drafts are Fleet-3 backlog, not operator debt (2026-08-05); they stay visible in Queue by kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Operator Inbox (items & reasons)",
              "url": "/d/sf-inbox/triage-e28094-operator-inbox"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "(sum(last_over_time(signal_fleet_queue_depth{kind=\"bug\"}[2h])) or vector(0)) + (sum(last_over_time(signal_fleet_escalations_7d[2h])) or vector(0))",
