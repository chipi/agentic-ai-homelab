{
 "uid": "homelab-mini",
 "title": "Homelab \u2014 Mac mini",
 "tags": [
  "homelab",
  "host",
  "macos"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "title": "Disk free (data vol)",
   "description": "Shows the percentage of free space on the data volume. A lower percentage means less free space available, which could indicate storage is filling up.",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "100*node_filesystem_avail_bytes{mountpoint=\"/System/Volumes/Data\",instance=\"homelab\"}/node_filesystem_size_bytes{mountpoint=\"/System/Volumes/Data\",instance=\"homelab\"}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 10
       },
       {
        "color": "green",
        "value": 20
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "title": "CPU busy",
   "description": "Shows the percentage of time the CPU is actively processing tasks. A higher value means the CPU is more heavily used, while a lower value means it is mostly idle.",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "100*(1-avg(rate(node_cpu_seconds_total{mode=\"idle\",instance=\"homelab\"}[$__rate_interval])))",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Memory used",
   "description": "Shows the percentage of total memory currently in use by active, wired, and compressed memory on the Mac mini. A higher percentage indicates more memory is being used, which may suggest heavy memory demand.",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "100*(node_memory_active_bytes{instance=\"homelab\"}+node_memory_wired_bytes{instance=\"homelab\"}+node_memory_compressed_bytes{instance=\"homelab\"})/node_memory_total_bytes{instance=\"homelab\"}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 80
       },
       {
        "color": "red",
        "value": 92
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "title": "Load 1m",
   "description": "Shows the average system load over the past minute, measured in number of processes waiting for CPU time. A higher value indicates more processes waiting, suggesting potential CPU congestion.",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "node_load1{instance=\"homelab\"}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 6
       },
       {
        "color": "red",
        "value": 12
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "Swap used",
   "description": "Shows the amount of swap memory currently in use on the Mac mini, measured in bytes. A higher value indicates more swap is being used, which may suggest limited physical memory.",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "node_memory_swap_used_bytes{instance=\"homelab\"}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 2147483648
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "title": "Uptime",
   "description": "Shows how many seconds the Mac mini has been running continuously. A higher value means the system has been up longer without rebooting.",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "node_time_seconds{instance=\"homelab\"}-node_boot_time_seconds{instance=\"homelab\"}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "title": "CPU by mode",
   "description": "Shows the percentage of time the CPU spends in each mode, including idle, user, system, and others. A higher value for user or system mode indicates more CPU activity, while a consistently high idle percentage means the CPU is mostly unused.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum by(mode)(rate(node_cpu_seconds_total{instance=\"homelab\"}[$__rate_interval]))/scalar(count(node_cpu_seconds_total{mode=\"idle\",instance=\"homelab\"}))",
     "legendFormat": "{{mode}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 60,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "title": "Memory regions",
   "description": "Shows the amount of memory in use, reserved, compressed, inactive, and free on the Mac mini, measured in bytes. Higher values for active, wired, or compressed memory indicate increased memory usage, while a rising free memory value suggests more available memory.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "node_memory_active_bytes{instance=\"homelab\"}",
     "legendFormat": "active"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "node_memory_wired_bytes{instance=\"homelab\"}",
     "legendFormat": "wired"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "node_memory_compressed_bytes{instance=\"homelab\"}",
     "legendFormat": "compressed"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "node_memory_inactive_bytes{instance=\"homelab\"}",
     "legendFormat": "inactive"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "node_memory_free_bytes{instance=\"homelab\"}",
     "legendFormat": "free"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 50,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "title": "Disk free % over time",
   "description": "Shows the percentage of free disk space on the Mac mini's main filesystems over time. A decreasing percentage indicates growing disk usage, while a low percentage means little free space remains.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "100*node_filesystem_avail_bytes{instance=\"homelab\",mountpoint=~\"/|/System/Volumes/Data\"}/node_filesystem_size_bytes{instance=\"homelab\",mountpoint=~\"/|/System/Volumes/Data\"}",
     "legendFormat": "{{mountpoint}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "title": "Network",
   "description": "Shows the current incoming and outgoing network traffic on the Mac mini in bytes per second. A high incoming or outgoing value indicates active data transfer, while a sudden change may signal a shift in network activity.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(rate(node_network_receive_bytes_total{instance=\"homelab\"}[$__rate_interval]))",
     "legendFormat": "rx"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "-sum(rate(node_network_transmit_bytes_total{instance=\"homelab\"}[$__rate_interval]))",
     "legendFormat": "tx"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "title": "Disk IO",
   "description": "Shows the rate of data read from and written to the disk in bytes per second. A high read or write value indicates active disk usage, while a sudden change may signal a spike in disk activity.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 20
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(rate(node_disk_read_bytes_total{instance=\"homelab\"}[$__rate_interval]))",
     "legendFormat": "read"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "-sum(rate(node_disk_written_bytes_total{instance=\"homelab\"}[$__rate_interval]))",
     "legendFormat": "write"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 12,
   "title": "CPU thermal speed-limit (1=full)",
   "description": "Shows the current CPU thermal speed limit as a fraction of full speed, where 1.0 means no throttling. A value below 1.0 indicates the CPU is running slower due to thermal constraints.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 20
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "node_thermal_cpu_speed_limit_ratio{instance=\"homelab\"}",
     "legendFormat": "speed-limit ratio"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 13,
   "title": "CPU temperature",
   "description": "Shows the current temperature of the Mac mini's CPU in degrees Celsius. A rising or high temperature may indicate increased workload or cooling issues.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 27
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "mini_cpu_temp_celsius",
     "legendFormat": "CPU die"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "min": 30,
     "max": 105,
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "lineWidth": 2,
      "thresholdsStyle": {
       "mode": "area"
      }
     },
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 85
       },
       {
        "color": "red",
        "value": 95
       }
      ]
     }
    },
    "overrides": []
   }
  }
 ]
}
