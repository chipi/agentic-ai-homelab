{
  "__comment": "Delivery worker (#1412 / ADR-145). Reads delivery_* series scraped from the workers (job=delivery, channel=email|push|events) into VictoriaMetrics. Bounce+complaint rate is the deliverability canary.",
  "title": "Delivery worker",
  "uid": "delivery-worker",
  "tags": [
    "delivery",
    "email",
    "push",
    "player"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(delivery_sent_total, tenant)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Worker up (up==1)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"delivery\",tenant=~\"$tenant\"}",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Sent by status (rate 5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(delivery_sent_total{tenant=~\"$tenant\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Bounce + complaint rate (canary)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(delivery_sent_total{tenant=~\"$tenant\",status=~\"bounced|complaint\"}[1h])) / clamp_min(sum(rate(delivery_sent_total{tenant=~\"$tenant\",status=~\"delivered|bounced|complaint\"}[1h])), 1)",
          "legendFormat": "bounce+complaint"
        }
      ]
    },
    {
      "id": 4,
      "title": "Batch pending depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel) (delivery_batch_pending{tenant=~\"$tenant\"})",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Dead-letters (24h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(delivery_sent_total{tenant=~\"$tenant\",status=\"dead_lettered\"}[24h]))",
          "legendFormat": "dead-lettered"
        }
      ]
    },
    {
      "id": 6,
      "title": "Events cursor age (poller lag)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 900
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(delivery_events_cursor_age_seconds{tenant=~\"$tenant\"})",
          "legendFormat": "cursor age"
        }
      ]
    },
    {
      "id": 7,
      "title": "Send latency p50/p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, channel) (rate(delivery_send_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "p50 {{channel}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(delivery_send_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "p95 {{channel}}"
        }
      ]
    }
  ]
}