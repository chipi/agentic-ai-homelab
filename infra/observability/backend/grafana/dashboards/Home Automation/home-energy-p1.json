      "title": "Import / export per day",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "increase(homeassistant_sensor_energy_kwh{job=\"home-assistant\",entity=\"sensor.p1_meter_energy_import\"}[$__interval])",
