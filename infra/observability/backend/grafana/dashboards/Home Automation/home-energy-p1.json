        {
          "expr": "increase(homeassistant_sensor_energy_kwh{job=\"home-assistant\",entity=\"sensor.p1_meter_energy_export\"}[7d])",
          "legendFormat": "export",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "B"
