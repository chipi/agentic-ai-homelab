            "uid": "victoriametrics"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "barAlignment": -1
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Energy sensors are total_increasing meter readings (kWh): shown as increase over the window, never as a rate. Buckets are aligned to UTC.",
      "interval": "1d"
    },
