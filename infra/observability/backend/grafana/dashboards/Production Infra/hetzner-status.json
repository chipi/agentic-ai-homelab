{
  "uid": "hetzner-status",
  "title": "Hetzner status bulletins",
  "tags": [
    "hetzner",
    "provider",
    "prod"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "description": "status.hetzner.com bulletins (Atom feed) correlated with prod's datacenters (infra/hetzner-status/ours.json). Built 2026-10-29.",
  "panels": [
    {
      "type": "stat",
      "title": "In the feed: direct",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "hetzner_status_feed_entries{instance=\"homelab\",relevance=\"direct\"}",
          "legendFormat": "direct",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Our datacenter NBG1-DC3 (prod-podcast), a whole-NBG1 bulletin, or text naming our DC. Alerts.",
      "id": 1
    },
    {
      "type": "stat",
      "title": "In the feed: nearby",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "hetzner_status_feed_entries{instance=\"homelab\",relevance=\"nearby\"}",
          "legendFormat": "nearby",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Same city, other or unknown datacenter: other NBG1 DCs; FSN1 (the audio Storage Box).",
      "id": 2
    },
    {
      "type": "stat",
      "title": "In the feed: service",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "hetzner_status_feed_entries{instance=\"homelab\",relevance=\"service\"}",
          "legendFormat": "service",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "A Hetzner service we use (Cloud Server, Network, Storage Box, ...), not tied to a place.",
      "id": 3
    },
    {
      "type": "stat",
      "title": "In the feed: other",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "hetzner_status_feed_entries{instance=\"homelab\",relevance=\"other\"}",
          "legendFormat": "other",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Other datacenters, General notices, products we do not use.",
      "id": 4
    },
    {
      "type": "stat",
      "title": "Poller: last good read",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "time() - max(hetzner_status_last_success_timestamp{instance=\"homelab\"})",
          "legendFormat": "age",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Alert hetzner-status-poller-stale after 1h.",
      "id": 5
    },
    {
      "type": "stat",
      "title": "Poll OK",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "hetzner_status_poll_ok{instance=\"homelab\"}",
          "legendFormat": "ok",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILING",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 6
    },
    {
      "type": "table",
      "title": "Relevant now (what the hub banner shows)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "last_over_time(hetzner_status_active{instance=\"homelab\"}[15m])",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "service": true,
              "environment": true,
              "job": true
            },
            "indexByName": {
              "relevance": 0,
              "phase": 1,
              "kind": 2,
              "category": 3,
              "title": 4,
              "start": 5,
              "end": 6,
              "link": 7
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "description": "direct/nearby bulletins that are ongoing or start within 7 days, and service bulletins while ongoing (hetzner_status_active). Empty = nothing relevant.",
      "id": 7
    },
    {
      "type": "logs",
      "title": "Bulletins (new or updated; backfill = what was in the feed when watching started)",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "expr": "app:hetzner-status | fields _time, _msg, relevance, affects, kind, category, start, end, backfill, link, summary",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "description": "Alert hetzner-status-ours fires on new direct bulletins only. Lines before 2026-10-29 16:00Z carry `affects` instead of `relevance`.",
      "id": 8
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}