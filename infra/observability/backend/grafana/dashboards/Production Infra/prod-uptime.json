{
  "uid": "prod-uptime",
  "title": "Prod uptime",
  "tags": [
    "prod",
    "uptime",
    "probe"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "description": "Outside-in availability of the prod endpoints, from the Mac mini every minute (job site-probe), and Cloudflare's own counts for every visitor (infra/cloudflare-edge). Built 2026-10-29.",
  "panels": [
    {
      "type": "table",
      "title": "Availability per endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "expr": "avg_over_time((max by (host) (probe_success{job=\"site-probe\",run_id=\"\"}) and on () (last_over_time(mini_vm_egress_ok{instance=\"homelab\",target=\"internet\"}[5m]) == 1))[24h:1m])",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "avg_over_time((max by (host) (probe_success{job=\"site-probe\",run_id=\"\"}) and on () (last_over_time(mini_vm_egress_ok{instance=\"homelab\",target=\"internet\"}[5m]) == 1))[7d:1m])",
          "format": "table",
          "instant": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "avg_over_time((max by (host) (probe_success{job=\"site-probe\",run_id=\"\"}) and on () (last_over_time(mini_vm_egress_ok{instance=\"homelab\",target=\"internet\"}[5m]) == 1))[30d:1m])",
          "format": "table",
          "instant": true,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "avg_over_time((max by (host) (probe_success{job=\"site-probe\",run_id=\"\"}) and on () (last_over_time(mini_vm_egress_ok{instance=\"homelab\",target=\"internet\"}[5m]) == 1))[$__range:1m])",
          "format": "table",
          "instant": true,
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "(1 - avg_over_time((max by (host) (probe_success{job=\"site-probe\",run_id=\"\"}) and on () (last_over_time(mini_vm_egress_ok{instance=\"homelab\",target=\"internet\"}[5m]) == 1))[$__range:1m])) * ($__range_s / 60)",
          "format": "table",
          "instant": true,
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "max by (host) (last_over_time(probe_success{job=\"site-probe\",run_id=\"\"}[3m]))",
          "format": "table",
          "instant": true,
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "host": "Endpoint",
              "Value #A": "24h",
              "Value #B": "7d",
              "Value #C": "30d",
              "Value #D": "Selected range",
              "Value #E": "Down minutes (range)",
              "Value #F": "Now"
            },
            "indexByName": {
              "host": 0,
              "Value #F": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Endpoint"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Down minutes (range)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "max",
                "value": null
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Now"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red"
                      },
                      "1": {
                        "text": "UP",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Selected range",
            "desc": false
          }
        ]
      },
      "description": "Share of 1-minute checks that passed, measured from the Mac mini (home internet) through Cloudflare like a visitor. Minutes when the mini's own internet was down are left out, not counted as down. Each endpoint's check is in infra/observability/hosts/homelab/config.alloy (the apps' API, the MCP servers' 401, GlitchTip's 405, pages by <title>). A window longer than an endpoint's history averages only the history there is (the probes started 2026-10-29).",
      "id": 1
    },
    {
      "type": "state-timeline",
      "title": "Up / down",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "expr": "max by (host) (probe_success{job=\"site-probe\",run_id=\"\"})",
          "legendFormat": "{{host}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "description": "Raw probe results, including minutes when the mini itself was offline (see the egress row below).",
      "id": 2
    },
    {
      "type": "state-timeline",
      "title": "The probe's own internet (mini egress)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 3
      },
      "targets": [
        {
          "expr": "last_over_time(mini_vm_egress_ok{instance=\"homelab\",target=\"internet\"}[5m])",
          "legendFormat": "mini egress",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "offline",
                  "color": "purple"
                },
                "1": {
                  "text": "online",
                  "color": "transparent"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              },
              {
                "color": "transparent",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "legend": {
          "showLegend": false
        }
      },
      "description": "Purple = the mini could not reach the internet; probe failures then say nothing about prod.",
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Response time",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "expr": "max by (host) (probe_duration_seconds{job=\"site-probe\"})",
          "legendFormat": "{{host}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "median",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Whole check, DNS + TLS + response, from the home internet.",
      "id": 4
    },
    {
      "type": "table",
      "title": "Edge certificate expiry",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "expr": "(min by (host) (probe_ssl_earliest_cert_expiry{job=\"site-probe\"}) - time()) / 86400",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "host": "Endpoint",
              "Value": "Days left"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 14
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Days left",
            "desc": false
          }
        ]
      },
      "description": "The certificate Cloudflare serves to visitors (Cloudflare renews it), not the origin certificate.",
      "id": 5
    },
    {
      "type": "table",
      "title": "Cloudflare: every visitor's requests per host, last 24h",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "expr": "sum by (host) (last_over_time(cloudflare_edge_requests{instance=\"homelab\",window=\"24h\",class=\"2xx\"}[15m]))",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "sum by (host) (last_over_time(cloudflare_edge_requests{instance=\"homelab\",window=\"24h\",class=\"3xx\"}[15m]))",
          "format": "table",
          "instant": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "sum by (host) (last_over_time(cloudflare_edge_requests{instance=\"homelab\",window=\"24h\",class=\"4xx\"}[15m]))",
          "format": "table",
          "instant": true,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "sum by (host) (last_over_time(cloudflare_edge_requests{instance=\"homelab\",window=\"24h\",class=\"5xx_server\"}[15m]))",
          "format": "table",
          "instant": true,
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "sum by (host) (last_over_time(cloudflare_edge_requests{instance=\"homelab\",window=\"24h\",class=\"5xx_unreachable\"}[15m]))",
          "format": "table",
          "instant": true,
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "sum by (host) (last_over_time(cloudflare_edge_requests{instance=\"homelab\",window=\"24h\",class=\"client_closed\"}[15m]))",
          "format": "table",
          "instant": true,
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "host": "Host",
              "Value #A": "2xx",
              "Value #B": "3xx",
              "Value #C": "4xx",
              "Value #D": "5xx from our server",
              "Value #E": "520-530 (origin unreachable)",
              "Value #F": "499 (client gave up)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "5xx.*|520.*"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 50
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "520-530 (origin unreachable)",
            "desc": true
          }
        ]
      },
      "description": "Cloudflare's GraphQL analytics, read every 5 min by infra/cloudflare-edge/poll.py (window ends 2 min ago). 520-526/530 are answered by Cloudflare when it cannot get a valid response from our origin, so the prod Caddy never logs them. Alert cloudflare-edge-unreachable: >= 20 in 1h and >= 5% of the host's requests.",
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Cloudflare: origin unreachable (520-530), rolling 1h",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (host) (cloudflare_edge_requests{instance=\"homelab\",window=\"1h\",class=\"5xx_unreachable\"})",
          "legendFormat": "{{host}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7
    },
    {
      "type": "bargauge",
      "title": "Cloudflare PoPs carrying our traffic (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 46,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "expr": "topk(10, last_over_time(cloudflare_edge_pop_share{instance=\"homelab\"}[15m]))",
          "legendFormat": "{{colo}}",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "A PoP carrying >= 5% of our requests counts as ours for Cloudflare status incidents (infra/cloudflare-edge/ours.json).",
      "id": 8
    },
    {
      "type": "table",
      "title": "Cloudflare status: what touches us",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 46,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "expr": "last_over_time(cloudflare_status_incident{instance=\"homelab\"}[10m])",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "last_over_time(cloudflare_status_maintenance{instance=\"homelab\"}[10m])",
          "format": "table",
          "instant": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "service": true,
              "environment": true,
              "job": true,
              "Value #A": true,
              "Value #B": true
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "description": "Unresolved incidents (relevance direct = lists a component we use) and maintenance on our PoPs within 24h, from cloudflarestatus.com.",
      "id": 9
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}