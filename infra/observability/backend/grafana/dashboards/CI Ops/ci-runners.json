    {
      "id": 11,
      "type": "state-timeline",
      "title": "Runners: offline, idle, busy",
      "description": "gh_runner_up + gh_runner_busy per runner: 0 offline, 1 online and idle, 2 busy.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "gh_runner_up{machine=\"x3\",repo=~\"$repo\",runner=~\"$runner\"} + gh_runner_busy{machine=\"x3\",repo=~\"$repo\",runner=~\"$runner\"}",
          "legendFormat": "{{runner}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.9,
        "legend": {
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "custom": {
            "fillOpacity": 80
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "offline",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "idle",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "busy",
                  "color": "blue",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "blue",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      }
    },
