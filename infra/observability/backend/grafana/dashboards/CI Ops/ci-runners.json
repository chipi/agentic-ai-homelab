{
  "uid": "ci-runners",
  "title": "CI runners \u2014 the X3 fleet",
  "tags": [
    "ci",
    "x3",
    "runners"
  ],
  "description": "The 16 GitHub Actions runners on the X3 (RFC-0011): who is online and busy, the queue, job slots, the 12-core / 48 GB slice, the runners' disk budgets, the CI alerts and the sync log. Overview of the other CI/CD health: CI Ops.",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "editable": true,
  "links": [
    {
      "title": "Hub: CI tab",
      "type": "link",
      "url": "https://hub.tail6d0ed4.ts.net/#ci",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "The Hub's CI tab"
    },
    {
      "title": "CI / Ops overview",
      "type": "link",
      "url": "/d/podcast-ci-ops-overview",
      "icon": "dashboard",
      "tooltip": "CI Ops overview dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
